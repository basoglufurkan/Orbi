    "A little robot curled up under a tree. It wakes for a moment, waves, and dozes off again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روبوت صغير متكوّر تحت شجرة. يصحو لحظة، يلوّح لك، ثم يغفو من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleiner Roboter, zusammengerollt unter einem Baum. Er wacht kurz auf, winkt und döst wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un robot pequeñito acurrucado bajo un árbol. Se despierta un momento, saluda con la mano y vuelve a dormirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit robot pelotonné sous un arbre. Il s’éveille un instant, fait un signe de la main, puis se rendort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un piccolo robot raggomitolato sotto un albero. Si sveglia per un attimo, saluta con la mano e torna a sonnecchiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "木の下で丸くなっている小さなロボット。少しだけ目を覚まして手を振り、またうとうとと眠ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나무 아래 웅크린 작은 로봇. 잠깐 깨어나 손을 흔들고는 다시 꾸벅꾸벅 잠들어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um robozinho encolhido debaixo de uma árvore. Ele acorda por um instante, acena e volta a cochilar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленький робот свернулся клубком под деревом. Он просыпается на миг, машет рукой и снова засыпает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หุ่นยนต์ตัวน้อยขดตัวอยู่ใต้ต้นไม้ มันตื่นขึ้นครู่หนึ่ง โบกมือ แล้วก็เคลิ้มหลับไปอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ağacın altında kıvrılmış küçük bir robot. Bir anlığına uyanıyor, el sallıyor ve yeniden uyukluyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个蜷在树下的小机器人。它醒来片刻，挥挥手，又打起了瞌睡。"
          }
        }
      }
    },
