        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Atmosphäre hüllt die Welt in einen sanft leuchtenden Saum und ziehende Wolken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una atmósfera envuelve el mundo en un suave halo luminoso y nubes que flotan a la deriva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une atmosphère enveloppe le monde d’un doux liseré lumineux et de nuages à la dérive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'atmosfera avvolge il mondo in un tenue bordo luminoso e in nuvole erranti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大気が世界を包み、やわらかく光る縁と流れる雲をまといます。"
