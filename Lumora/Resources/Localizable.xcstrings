        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 우주로 만드는 더 많은 방법."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais jeitos de deixar seu universo com a sua cara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше способов сделать вселенную своей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีกหลายวิธีที่จะทำให้จักรวาลเป็นของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
