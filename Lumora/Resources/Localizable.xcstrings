    "This world blinks once every thousand years. You arrived just in time to see it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرمش هذا العالَم مرة كل ألف عام. وقد وصلت في الوقت المناسب تمامًا لتراه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Welt blinzelt einmal in tausend Jahren. Du bist gerade rechtzeitig gekommen, um es zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mundo parpadea una vez cada mil años. Llegaste justo a tiempo para verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce monde cligne des yeux une fois tous les mille ans. Tu es arrivé·e juste à temps pour le voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo mondo sbatte le palpebre una volta ogni mille anni. Sei qui giusto in tempo per vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この世界は千年に一度だけまばたきします。あなたはちょうどその瞬間に間に合いました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세계는 천 년에 한 번 눈을 깜빡여요. 마침 그 순간에 맞춰 도착했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mundo pisca uma vez a cada mil anos. Você chegou bem a tempo de ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот мир моргает раз в тысячу лет. И ты здесь как раз вовремя, чтобы это увидеть."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โลกนี้กะพริบตาพันปีครั้ง และคุณมาถึงทันเวลาพอดีที่จะได้เห็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dünya bin yılda bir göz kırpıyor. Tam görecek zamanda geldin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个世界每一千年才眨一次眼。你恰好赶上了这一刻。"
          }
        }
      }
    },
    "This world hasn't formed yet" : {
