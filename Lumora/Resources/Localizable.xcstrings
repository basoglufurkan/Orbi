    "The ice grows in the shape of sound waves, so every cave holds a song." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينمو الجليد على هيئة موجات صوتية، فيحتضن كل كهف أغنية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Eis wächst in Form von Schallwellen, und so birgt jede Höhle ein Lied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El hielo crece con forma de ondas sonoras, así que cada cueva guarda una canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La glace pousse en forme d’ondes sonores : chaque grotte renferme une chanson."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ghiaccio cresce a forma di onde sonore, così ogni grotta custodisce una canzone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "氷は音の波のかたちに育つので、どの洞窟にも歌が眠っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼음이 소리의 물결 모양으로 자라서, 동굴마다 노래가 담겨 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gelo cresce em forma de ondas sonoras, então cada caverna guarda uma canção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёд растёт в форме звуковых волн, и в каждой пещере живёт песня."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้ำแข็งงอกเป็นรูปคลื่นเสียง ทุกถ้ำจึงเก็บบทเพลงไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buz ses dalgaları biçiminde büyüyor; bu yüzden her mağarada bir şarkı saklı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冰按照声波的形状生长，所以每个洞穴里都藏着一首歌。"
          }
        }
      }
    },
