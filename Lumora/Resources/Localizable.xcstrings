            "value" : "Dein Himmel\nwächst heute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cielo crece\nhoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton ciel\ngrandit aujourd’hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
