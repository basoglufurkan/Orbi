    "Earned %@. It now lives in your collection forever." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُصِّلت في %@. وهي الآن في مجموعتك إلى الأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten am %@. Es bleibt für immer in deiner Sammlung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenido %@. Ahora vive en tu colección para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenu le %@. Il fait désormais partie de ta collection pour toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottenuto %@. Ora vive per sempre nella tua collezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に獲得。これからずっとコレクションに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 획득. 이제 컬렉션에 영원히 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conquistado em %@. Agora ele vive na sua coleção para sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получен %@. Теперь он навсегда в твоей коллекции."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้รับเมื่อ %@ ตอนนี้อยู่ในคอลเลกชันของคุณตลอดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
