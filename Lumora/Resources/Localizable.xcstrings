    "Your name stays with your Apple ID. Orbi keeps no account on a server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى اسمك مع حساب Apple الخاص بك. لا يحتفظ Orbi بأي حساب على خادم."
          }
        },
        "de" : {
          "stringUnit" : {
