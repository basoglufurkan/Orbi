        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해돋이를 보기 가장 좋은 곳으로 이어지는 빛나는 발자국."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
