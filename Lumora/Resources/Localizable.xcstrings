    "Sparks drift up through the warm air and become, for a moment, brand new constellations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شرارات تصعد عبر الهواء الدافئ وتصير، للحظة، كوكبات جديدة تمامًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funken steigen durch die warme Luft und werden für einen Augenblick zu ganz neuen Sternbildern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las chispas suben por el aire cálido y se convierten, por un instante, en constelaciones recién nacidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des étincelles montent dans l’air chaud et deviennent, l’espace d’un instant, de toutes nouvelles constellations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scintille salgono nell'aria calda e diventano, per un attimo, costellazioni nuove di zecca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火の粉があたたかな空気の中を舞いあがり、ほんのひととき、生まれたての星座になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불티가 따뜻한 공기를 타고 떠올라 잠시 동안 갓 태어난 별자리가 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faíscas sobem pelo ar quente e se tornam, por um instante, constelações novinhas em folha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искры поднимаются в тёплом воздухе и на миг становятся совсем новыми созвездиями."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประกายไฟลอยขึ้นผ่านอากาศอุ่น แล้วกลายเป็นกลุ่มดาวใหม่เอี่ยมอยู่ชั่วครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kıvılcımlar sıcak havada yükseliyor ve bir anlığına yepyeni takımyıldızlara dönüşüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火星在温暖的空气中升腾，片刻之间，化作崭新的星座。"
          }
        }
      }
    },
