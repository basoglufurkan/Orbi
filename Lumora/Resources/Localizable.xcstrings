    "Worlds you haven't landed on yet appear here, veiled. None right now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا العوالم التي لم تهبط عليها بعد، محجوبة. لا شيء حاليًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welten, auf denen du noch nicht gelandet bist, erscheinen hier verhüllt. Gerade keine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mundos en los que aún no has aterrizado aparecen aquí, velados. Ninguno por ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mondes pas encore visités apparaissent ici, voilés. Aucun pour l'instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I mondi non ancora visitati appaiono qui, velati. Nessuno per ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ降り立っていない世界が、ベールに包まれてここに現れます。今はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 착륙하지 않은 세계가 베일에 싸인 채 여기 나타나요. 지금은 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mundos onde você ainda não pousou aparecem aqui, velados. Nenhum agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Миры, где ещё не было посадки, появляются здесь под вуалью. Сейчас таких нет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โลกที่คุณยังไม่เคยลงจอดจะปรากฏที่นี่แบบเลือนราง ตอนนี้ยังไม่มี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz inmediğin dünyalar burada örtülü görünür. Şu an yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未登陆的世界会以朦胧的样子出现在这里。目前没有。"
          }
        }
      }
    },
