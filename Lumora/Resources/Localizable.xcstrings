    "Old, warm and humming: the oldest stars sing in low notes here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عتيقة ودافئة ومُدندِنة: هنا تغنّي أقدم النجوم بنغمات خفيضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt, warm und summend: Hier singen die ältesten Sterne in tiefen Tönen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigua, cálida y vibrante: aquí las estrellas más viejas cantan en notas graves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancienne, chaude et fredonnante : ici, les plus vieilles étoiles chantent dans les graves."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antica, calda e vibrante: qui le stelle più vecchie cantano note profonde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古く、あたたかく、ハミングする銀河。ここではいちばん古い星たちが低い音で歌っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래되고 따뜻하며 나지막이 울리는 곳. 이곳에선 가장 오래된 별들이 낮은 음으로 노래해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antiga, quente e vibrante: aqui as estrelas mais velhas cantam em notas graves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Древняя, тёплая и гудящая: здесь старейшие звёзды поют низкими нотами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก่าแก่ อบอุ่น และฮัมเพลง: ที่นี่ดาวที่เก่าแก่ที่สุดขับขานด้วยโน้ตทุ้มต่ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşlı, sıcak ve mırıl mırıl: en eski yıldızlar burada pes notalarla şarkı söylüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古老、温暖、低声哼唱：最古老的星辰在这里以低音歌唱。"
          }
        }
      }
    },
