    "Rain, tides, solar wind and a crackling campfire while you focus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطر ومد وجزر ورياح شمسية ونار مخيم تطقطق أثناء تركيزك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regen, Gezeiten, Sonnenwind und ein knisterndes Lagerfeuer, während du dich fokussierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lluvia, mareas, viento solar y una fogata crepitante mientras te concentras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluie, marées, vent solaire et feu de camp crépitant pendant ta concentration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pioggia, maree, vento solare e un falò scoppiettante mentre ti concentri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中中に、雨、潮騒、太陽風、パチパチはぜる焚き火を。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중하는 동안 비, 파도, 태양풍, 타닥타닥 모닥불 소리를."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuva, marés, vento solar e uma fogueira crepitante enquanto você foca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождь, приливы, солнечный ветер и потрескивающий костёр, пока ты сосредоточен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฝน คลื่น ลมสุริยะ และกองไฟเปาะแปะ ระหว่างที่คุณโฟกัส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaklanırken yağmur, gelgit, güneş rüzgârı ve çıtırdayan kamp ateşi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注时聆听雨声、潮汐、太阳风和噼啪作响的篝火。"
          }
        }
      }
