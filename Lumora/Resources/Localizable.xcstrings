    "Home. A young spiral where your first light was given to you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الديار. دوّامة فتيّة أُهدي إليك فيها ضوؤك الأول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuhause. Eine junge Spirale, in der dir dein erstes Licht geschenkt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogar. Una espiral joven donde recibiste tu primera luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta maison. Une jeune spirale où ta première lumière t’a été offerte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa. Una giovane spirale dove ti è stata donata la tua prima luce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふるさと。あなたの最初の光が贈られた、若い渦巻銀河。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고향. 나의 첫 빛을 선물받은 젊은 나선 은하."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar. Uma espiral jovem onde você recebeu sua primeira luz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дом. Юная спираль, где тебе подарили твой первый свет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บ้าน กังหันดาราอันเยาว์วัยที่ซึ่งคุณได้รับแสงแรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuva. İlk ışığının sana verildiği genç bir sarmal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家园。一片年轻的旋涡星系，你的第一缕光在这里被赠予你。"
          }
        }
      }
    },
