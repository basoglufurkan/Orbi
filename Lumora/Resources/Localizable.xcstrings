        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ยังไม่ต้องจ่าย ยกเลิกได้ทุกเมื่อก่อนช่วงทดลองใช้สิ้นสุด"
          }
        },
        "tr" : {
