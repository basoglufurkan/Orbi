    "Invite friends" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادعُ أصدقاءك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freunde einladen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitar amigos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter des amis"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita amici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちを招待"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구 초대하기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convidar amigos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригласить друзей"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชวนเพื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaşlarını davet et"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀请朋友"
          }
        }
      }
    },
    "Invite up to 7 friends. You'll sit together in one galaxy, each at your own desk, while you focus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادعُ حتى 7 أصدقاء. ستجلسون معًا في مجرّة واحدة، كلٌّ على مكتبه، أثناء التركيز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade bis zu 7 Freunde ein. Beim Fokussieren sitzt ihr zusammen in einer Galaxie, jeder an seinem eigenen Schreibtisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita hasta a 7 amigos. Os sentaréis juntos en una galaxia, cada uno en su escritorio, mientras os concentráis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite jusqu'à 7 amis. Vous serez assis ensemble dans une galaxie, chacun à son bureau, pendant votre concentration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita fino a 7 amici. Mentre vi concentrate, sarete insieme in una galassia, ognuno alla sua scrivania."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大7人の友だちを招待できます。集中している間、みんな同じ銀河で、それぞれの机に座ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구를 최대 7명까지 초대하세요. 집중하는 동안 모두 한 은하에서 각자의 책상에 앉아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convide até 7 amigos. Enquanto focam, vocês ficam juntos em uma galáxia, cada um na sua mesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригласите до 7 друзей. Пока вы фокусируетесь, вы сидите вместе в одной галактике — каждый за своим столом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชวนเพื่อนได้สูงสุด 7 คน ระหว่างโฟกัส ทุกคนจะนั่งอยู่ในกาแล็กซีเดียวกัน แต่ละคนที่โต๊ะของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 arkadaşına kadar davet et. Odaklanırken hepiniz aynı galakside, kendi masanızda oturacaksınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多邀请 7 位朋友。专注时，你们会在同一个银河里，各坐在自己的书桌前。"
          }
        }
      }
    },
