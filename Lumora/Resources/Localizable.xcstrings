    "Twice a day gravity softens, and everything loose floats up a few centimetres." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرتين كل يوم تلين الجاذبية، فيطفو كل شيء غير مثبّت بضعة سنتيمترات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweimal am Tag wird die Schwerkraft sanfter, und alles Lose schwebt ein paar Zentimeter empor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos veces al día, la gravedad se suaviza y todo lo que está suelto se eleva unos centímetros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux fois par jour, la gravité s’adoucit, et tout ce qui n’est pas attaché s’élève de quelques centimètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due volte al giorno la gravità si attenua, e tutto ciò che non è fissato si solleva di qualche centimetro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日に二度、重力がゆるみ、固定されていないものはみな数センチ浮かびあがります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 두 번 중력이 느슨해져서, 고정되지 않은 것들이 몇 센티미터씩 떠올라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas vezes por dia, a gravidade se suaviza, e tudo o que está solto flutua alguns centímetros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды в день гравитация слабеет, и всё незакреплённое всплывает на пару сантиметров."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันละสองครั้ง แรงโน้มถ่วงจะอ่อนลง และทุกสิ่งที่ไม่ได้ยึดไว้จะลอยขึ้นสองสามเซนติเมตร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde iki kez yerçekimi yumuşuyor ve bağlı olmayan her şey birkaç santim havalanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天两次，重力会变得柔和，所有没固定住的东西都会浮起几厘米。"
          }
        }
      }
    },
    "Twin sunrise" : {
