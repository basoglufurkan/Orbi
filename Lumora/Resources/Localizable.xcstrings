    "Seven full days of light, kept like rings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبعة أيام كاملة من الضوء، محفوظة كالحلقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieben volle Tage voller Licht, bewahrt wie Jahresringe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete días completos de luz, guardados como anillos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sept jours pleins de lumière, gardés comme des anneaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sette giorni pieni di luce, custoditi come anelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まる7日間の光を、年輪のように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온전한 7일의 빛을 나이테처럼 간직했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sete dias inteiros de luz, guardados como anéis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семь полных дней света, сохранённых, как кольца."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงตลอดเจ็ดวันเต็ม เก็บไว้ดั่งวงแหวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedi tam gün ışık, halkalar gibi saklandı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整整七天的光，像年轮一样被珍藏。"
          }
        }
      }
    },
    "Shadows here sometimes wander off on their own, and always come home by evening." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الظلال هنا تتجوّل وحدها أحيانًا، وتعود دائمًا إلى بيتها قبل المساء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schatten gehen hier manchmal allein spazieren und kommen immer bis zum Abend nach Hause."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí las sombras a veces se van de paseo por su cuenta, y siempre vuelven a casa al anochecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, les ombres partent parfois se promener seules, et rentrent toujours avant le soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui le ombre a volte se ne vanno in giro da sole, e tornano sempre a casa entro sera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは影がときどき勝手に出かけていきますが、夕方までには必ず帰ってきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳의 그림자는 가끔 혼자 산책을 떠났다가, 저녁이면 꼭 돌아와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui as sombras às vezes saem passeando sozinhas, e sempre voltam para casa ao anoitecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тени здесь порой уходят гулять сами по себе и всегда возвращаются домой к вечеру."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บางครั้งเงาที่นี่ก็เดินเตร่ไปเอง และกลับบ้านทันก่อนเย็นเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradaki gölgeler bazen kendi başlarına gezintiye çıkıyor ve akşama hep eve dönüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里的影子有时会自己溜出去闲逛，但总会在傍晚前回家。"
          }
        }
      }
    },
