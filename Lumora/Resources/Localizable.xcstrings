    "A goal you choose. Reach it for a burst of stardust." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدف تختاره أنت. ابلغه لتنال دفقة من غبار النجوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ziel, das du selbst wählst. Erreichst du es, regnet es Sternenstaub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una meta que eliges tú. Alcánzala y recibe una lluvia de polvo estelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objectif que tu choisis. Atteins-le et reçois une pluie de poussières d’étoiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un obiettivo che scegli tu. Raggiungilo e riceverai una pioggia di polvere di stelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で選ぶ目標。たどり着くと、星くずがたくさん届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스스로 고르는 목표. 닿으면 별가루가 한가득 쏟아져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma meta que você escolhe. Alcance-a e ganhe uma chuva de poeira estelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель, которую выбираешь ты. Достигни её — и тебя осыплет звёздной пылью."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป้าหมายที่คุณเลือกเอง ไปให้ถึงแล้วรับละอองดาวเต็มกำมือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi seçtiğin bir hedef. Ulaş, bir avuç yıldız tozu kazan."
