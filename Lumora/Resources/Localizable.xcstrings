    "Star #%lld is settling in. Let your eyes go soft." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النجمة رقم %lld تستقرّ في مكانها. دع عينيك تسترخيان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stern Nr. %lld kommt zur Ruhe. Lass deinen Blick weich werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estrella n.º %lld se está asentando. Relaja la mirada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’étoile n° %lld prend sa place. Laisse ton regard s’adoucir."
          }
