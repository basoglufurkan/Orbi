    "Archiving hides the task. Its stars stay in your universe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأرشفة تُخفي المهمة. وتبقى نجومها في كونك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivieren blendet die Aufgabe aus. Ihre Sterne bleiben in deinem Universum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivar oculta la tarea. Sus estrellas se quedan en tu universo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiver masque la tâche. Ses étoiles restent dans ton univers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviare nasconde l'attività. Le sue stelle restano nel tuo universo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブするとタスクは非表示になります。星は宇宙に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관하면 할 일이 숨겨져요. 별은 우주에 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivar oculta a tarefa. As estrelas dela continuam no seu universo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задача скроется, но её звёзды останутся в твоей вселенной."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเก็บถาวรจะซ่อนงานนี้ แต่ดาวของมันยังอยู่ในจักรวาลของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivlemek görevi gizler. Yıldızları evreninde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档会隐藏任务，它的星星仍留在你的宇宙中。"
          }
        }
      }
    },
