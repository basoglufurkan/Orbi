    "Screen Time access is off for Orbi. You can allow it in Settings › Screen Time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى مدة استخدام الجهاز متوقف لـ Orbi. يمكنك السماح به من الإعدادات › مدة استخدام الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirmzeit-Zugriff ist für Orbi aus. Du kannst ihn unter Einstellungen › Bildschirmzeit erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a Tiempo de uso está desactivado para Orbi. Puedes permitirlo en Ajustes › Tiempo de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à Temps d'écran est désactivé pour Orbi. Tu peux l'autoriser dans Réglages › Temps d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso a Tempo di utilizzo è disattivato per Orbi. Puoi consentirlo in Impostazioni › Tempo di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbiのスクリーンタイムへのアクセスはオフだよ。設定 › スクリーンタイムで許可できるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi의 스크린 타임 접근이 꺼져 있어요. 설정 › 스크린 타임에서 허용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao Tempo de Uso está desligado para o Orbi. Você pode permiti-lo em Ajustes › Tempo de Uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к Экранному времени для Orbi выключен. Его можно включить в Настройках › Экранное время."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงเวลาหน้าจอของ Orbi ปิดอยู่ อนุญาตได้ที่ การตั้งค่า › เวลาหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi için Ekran Süresi erişimi kapalı. Ayarlar › Ekran Süresi'nden izin verebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi 的屏幕使用时间访问已关闭。你可以在“设置 › 屏幕使用时间”中开启。"
          }
        }
      }
    },
    "Screen Time access wasn't allowed. You can allow it for Orbi in Settings › Screen Time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسمح بالوصول إلى مدة استخدام الجهاز. يمكنك السماح به لـ Orbi من الإعدادات › مدة استخدام الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf Bildschirmzeit wurde nicht erlaubt. Du kannst ihn für Orbi unter Einstellungen › Bildschirmzeit erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se permitió el acceso a Tiempo de uso. Puedes permitirlo para Orbi en Ajustes › Tiempo de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à Temps d'écran n'a pas été autorisé. Tu peux l'autoriser pour Orbi dans Réglages › Temps d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso a Tempo di utilizzo non è stato consentito. Puoi consentirlo per Orbi in Impostazioni › Tempo di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンタイムへのアクセスが許可されませんでした。設定 › スクリーンタイムでOrbiに許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린 타임 접근이 허용되지 않았어요. 설정 › 스크린 타임에서 Orbi에 허용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao Tempo de Uso não foi permitido. Você pode permiti-lo para o Orbi em Ajustes › Tempo de Uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к Экранному времени не разрешён. Его можно включить для Orbi в Настройках › Экранное время."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้อนุญาตการเข้าถึงเวลาหน้าจอ คุณอนุญาตให้ Orbi ได้ที่ การตั้งค่า › เวลาหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Süresi erişimine izin verilmedi. Ayarlar › Ekran Süresi'nden Orbi'ye izin verebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未允许访问屏幕使用时间。你可以在“设置 › 屏幕使用时间”中为 Orbi 开启。"
          }
        }
      }
    },
