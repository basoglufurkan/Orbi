    "Once a day the whole planet goes quiet, as if it is listening for something." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرة كل يوم يسكن الكوكب كله، كأنه يُصغي إلى شيء ما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal am Tag wird der ganze Planet still, als lausche er auf etwas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez al día, todo el planeta se queda en silencio, como si estuviera escuchando algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois par jour, toute la planète se tait, comme si elle tendait l’oreille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta al giorno l'intero pianeta tace, come se stesse ascoltando qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日に一度、惑星全体が静まりかえります。何かに耳をすませているかのように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 한 번, 행성 전체가 조용해져요. 무언가에 귀 기울이는 것처럼."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vez por dia, o planeta inteiro fica em silêncio, como se estivesse escutando algo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раз в день вся планета затихает, будто к чему-то прислушивается."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันละครั้ง ทั้งดาวจะเงียบลง ราวกับกำลังตั้งใจฟังบางสิ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde bir kez bütün gezegen susuyor, sanki bir şeye kulak veriyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天有一次，整颗星球会安静下来，仿佛在倾听着什么。"
          }
        }
      }
    },
