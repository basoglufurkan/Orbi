    "Rivers here flow for thousands of kilometres and never reach a sea. The ring simply has no end." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجري الأنهار هنا آلاف الكيلومترات ولا تبلغ بحرًا أبدًا. فالحلقة ببساطة بلا نهاية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flüsse hier fließen Tausende Kilometer weit und erreichen nie ein Meer. Der Ring hat einfach kein Ende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí los ríos fluyen durante miles de kilómetros sin llegar nunca al mar. El anillo, sencillamente, no tiene fin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, les rivières coulent sur des milliers de kilomètres sans jamais atteindre la mer. L’anneau n’a tout simplement pas de fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui i fiumi scorrono per migliaia di chilometri senza mai raggiungere un mare. L'anello, semplicemente, non ha fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここの川は何千キロも流れ続け、海にたどり着くことはありません。この環には、終わりがないのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳의 강은 수천 킬로미터를 흘러도 바다에 닿지 않아요. 고리에는 끝이 없으니까요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui os rios correm por milhares de quilômetros e nunca chegam a um mar. O anel simplesmente não tem fim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реки здесь текут тысячи километров и так и не достигают моря. У кольца просто нет конца."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม่น้ำที่นี่ไหลยาวนับพันกิโลเมตรโดยไม่เคยถึงทะเล เพราะวงแหวนนี้ไม่มีจุดสิ้นสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradaki nehirler binlerce kilometre akıyor ve hiçbir denize ulaşmıyor. Halkanın bir sonu yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里的河流奔流数千公里，却永远到不了海。这道环，本就没有尽头。"
          }
        }
      }
    },
    "Rivers of light run through a crust of black glass." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهار من نور تجري عبر قشرة من زجاج أسود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flüsse aus Licht ziehen durch eine Kruste aus schwarzem Glas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ríos de luz recorren una corteza de cristal negro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rivières de lumière coulent sous une croûte de verre noir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiumi di luce scorrono in una crosta di vetro nero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黒いガラスの地殻を、光の川が流れています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검은 유리 지각 사이로 빛의 강이 흘러요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rios de luz correm por uma crosta de vidro negro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реки света бегут сквозь корку чёрного стекла."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายธารแห่งแสงไหลผ่านเปลือกโลกที่เป็นแก้วสีดำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siyah camdan bir kabuğun altından ışık nehirleri akıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光之河流淌在黑色玻璃般的地壳之下。"
          }
        }
      }
    },
