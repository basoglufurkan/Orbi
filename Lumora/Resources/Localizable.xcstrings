    "Finish a session and Orbi will start reflecting your light back to you — gently, never as a scoreboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ جلسة وسيبدأ Orbi بعكس ضوئك إليك — بلطف، لا كلوحة نتائج أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe eine Session ab, und Orbi spiegelt dir dein Licht zurück – sanft, niemals als Punktestand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una sesión y Orbi empezará a reflejar tu luz — con suavidad, nunca como un marcador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine une séance et Orbi commencera à te refléter ta lumière — en douceur, jamais comme un tableau de scores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa una sessione e Orbi inizierà a rifletterti la tua luce — con delicatezza, mai come un punteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを終えると、Orbiがあなたの光を映し返しはじめます — スコアボードではなく、そっと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 마치면 Orbi가 그 빛을 다시 비춰 주기 시작해요 — 점수판이 아니라, 부드럽게."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclua uma sessão e o Orbi vai começar a refletir sua luz de volta para você — com delicadeza, nunca como um placar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заверши сессию, и Orbi начнёт отражать твой свет обратно — бережно и никогда не как табло со счётом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำเซสชันให้จบ แล้ว Orbi จะเริ่มสะท้อนแสงของคุณกลับมาให้เห็น — อย่างอ่อนโยน ไม่ใช่กระดานคะแนน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir seansı bitir, Orbi ışığını sana yansıtmaya başlasın — nazikçe, asla bir skor tablosu gibi değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
