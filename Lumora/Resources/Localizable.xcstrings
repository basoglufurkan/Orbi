        }
      }
    },
    "The shell is smooth and warm as a pearl. Somewhere deep inside, the star is humming to itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصَّدَفة ملساء ودافئة كاللؤلؤة. وفي مكان عميق بداخلها، يدندن النجم لنفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hülle ist glatt und warm wie eine Perle. Irgendwo tief im Inneren summt der Stern leise vor sich hin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La concha es lisa y cálida como una perla. En algún lugar de su interior, la estrella canturrea para sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coquille est lisse et tiède comme une perle. Quelque part tout au fond, l’étoile fredonne pour elle-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il guscio è liscio e tiepido come una perla. Da qualche parte, nel profondo, la stella canticchia tra sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "殻は真珠のようにすべすべであたたかく、その奥深くで、星がひとりハミングしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "껍질은 진주처럼 매끈하고 따뜻해요. 그 깊은 곳 어딘가에서 별이 혼자 콧노래를 불러요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A concha é lisa e morna como uma pérola. Em algum lugar lá dentro, a estrela cantarola para si mesma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорлупа гладкая и тёплая, как жемчуг. Где-то глубоко внутри звезда что-то напевает себе под нос."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลือกนั้นเรียบลื่นและอบอุ่นดั่งไข่มุก ที่ไหนสักแห่งลึกเข้าไป ดาวดวงนั้นกำลังฮัมเพลงกับตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk bir inci kadar pürüzsüz ve sıcak. Derinlerde bir yerde yıldız kendi kendine mırıldanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外壳如珍珠般光滑温暖。在深处某个地方，那颗恒星正独自哼着歌。"
          }
        }
      }
    },
