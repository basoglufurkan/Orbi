    "Nothing to pay today. Cancel anytime before the trial ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء تدفعه اليوم. يمكنك الإلغاء في أي وقت قبل انتهاء الفترة التجريبية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute zahlst du nichts. Kündige jederzeit vor Ende des Testzeitraums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no pagas nada. Cancela cuando quieras antes de que termine la prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
