    "More ways to make your universe your own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طرق أكثر لتجعل كونك خاصًا بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Wege, dein Universum zu deinem zu machen."
