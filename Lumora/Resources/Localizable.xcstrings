    "A pink, shallow sea covers everything, so clear that the coral continents seem to float in the air." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحر وردي ضحل يغمر كل شيء، صافٍ حتى لتبدو قارات المرجان كأنها تطفو في الهواء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein rosa, seichtes Meer bedeckt alles, so klar, dass die Korallenkontinente in der Luft zu schweben scheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mar rosa y poco profundo lo cubre todo, tan transparente que los continentes de coral parecen flotar en el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mer rose et peu profonde recouvre tout, si limpide que les continents de corail semblent flotter dans les airs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mare rosa e poco profondo ricopre ogni cosa, così limpido che i continenti di corallo sembrano sospesi nell'aria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅い桃色の海がすべてを覆っています。あまりに澄んでいるので、サンゴの大陸が宙に浮いているように見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얕은 분홍빛 바다가 모든 것을 덮고 있어요. 너무 맑아서 산호 대륙이 공중에 떠 있는 것처럼 보여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mar rosa e raso cobre tudo, tão transparente que os continentes de coral parecem flutuar no ar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё укрыто розовым мелким морем — таким прозрачным, что коралловые материки будто парят в воздухе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทะเลตื้นสีชมพูปกคลุมทุกสิ่ง ใสจนทวีปปะการังดูราวกับลอยอยู่กลางอากาศ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembe, sığ bir deniz her yeri kaplıyor; öyle berrak ki mercan kıtaları havada süzülüyor sanırsın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅浅的粉色海洋覆盖一切，清澈得仿佛珊瑚大陆悬浮在空中。"
          }
        }
      }
    },
