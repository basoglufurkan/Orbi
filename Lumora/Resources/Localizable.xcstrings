    "Broken long ago, still holding its pieces close." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انكسر منذ زمن بعيد، وما زال يضمّ شظاياه إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor langer Zeit zerbrochen, hält sie ihre Stücke noch immer nah beieinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roto hace mucho, aún mantiene sus pedazos cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brisé il y a longtemps, il garde encore ses morceaux tout près de lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infranto tanto tempo fa, tiene ancora stretti i suoi frammenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠い昔に砕け、いまもそのかけらをそっと抱き寄せています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래전 부서졌지만, 여전히 조각들을 꼭 끌어안고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partido há muito tempo, ainda mantém seus pedaços por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расколот давным-давно, но всё ещё бережно держит свои осколки рядом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตกสลายมานานแล้ว แต่ยังคงโอบเศษเสี้ยวของตัวเองไว้ใกล้ ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok önce kırılmış, parçalarını hâlâ bağrına basıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很久以前就已破碎，却依然把碎片紧紧拥在身边。"
          }
        }
      }
    },
