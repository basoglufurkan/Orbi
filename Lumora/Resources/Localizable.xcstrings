    "Cancel in Settings › Apple Account › Subscriptions. Orbi+ stays until the year you paid for ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ من الإعدادات › حساب Apple › الاشتراكات. يبقى Orbi+ متاحًا حتى نهاية السنة التي دفعت ثمنها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kündige in Einstellungen › Apple Account › Abonnements. Orbi+ bleibt bis zum Ende des bezahlten Jahres aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela en Ajustes › Cuenta de Apple › Suscripciones. Orbi+ sigue activo hasta que termine el año que pagaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résilie dans Réglages › Compte Apple › Abonnements. Orbi+ reste actif jusqu'à la fin de l'année payée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla in Impostazioni › Account Apple › Abbonamenti. Orbi+ resta attivo fino alla fine dell'anno pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「Appleアカウント」›「サブスクリプション」から解約できます。Orbi+はお支払い済みの1年間が終わるまで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › Apple 계정 › 구독에서 취소하세요. Orbi+는 결제한 1년이 끝날 때까지 유지돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele em Ajustes › Conta Apple › Assinaturas. O Orbi+ continua ativo até o fim do ano pago."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмените в Настройках › Аккаунт Apple › Подписки. Orbi+ останется до конца оплаченного года."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกได้ที่ การตั้งค่า › บัญชี Apple › การสมัครรับ โดย Orbi+ จะยังใช้ได้จนครบปีที่ชำระไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar › Apple Hesabı › Abonelikler'den iptal et. Orbi+, ödediğin yıl bitene kadar açık kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在“设置”›“Apple 账户”›“订阅”中取消。Orbi+ 将保留到已付费的一年结束。"
          }
        }
      }
    },
    "Captured by a world after a season of steady focus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جذبها عالَمٌ بعد موسم من التركيز الثابت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von einer Welt eingefangen nach einer Zeit beständigen Fokus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturado por un mundo tras una temporada de enfoque constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturé par un monde après une saison de concentration régulière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catturato da un mondo dopo una stagione di concentrazione costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "着実な集中の季節を経て、ある世界にとらえられました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾸준한 집중의 계절 끝에 한 세계에 붙잡혔어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturado por um mundo após uma temporada de foco constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найден миром после сезона ровного фокуса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถูกโลกใบหนึ่งดึงดูดไว้หลังการโฟกัสอย่างสม่ำเสมอตลอดหนึ่งฤดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstikrarlı bir odak mevsiminin ardından bir dünyanın çekimine kapıldı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经过一季的稳定专注，被一个世界捕获。"
          }
        }
      }
    },
    "Carved with a single word that means both hello and rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقشت عليه كلمة واحدة تعني «مرحبًا» و«استرح» معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingemeißelt ist ein einziges Wort, das zugleich „Hallo“ und „Ruh dich aus“ bedeutet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva grabada una sola palabra que significa a la vez hola y descanso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On y a gravé un seul mot, qui veut dire à la fois « bonjour » et « repose-toi »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi è incisa un'unica parola che significa sia ciao sia riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「こんにちは」と「ひと休み」、そのどちらも意味するひとつの言葉が刻まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“안녕”과 “쉬어 가요”를 함께 뜻하는 한 단어가 새겨져 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem gravada uma única palavra que significa ao mesmo tempo olá e descanso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На нём высечено одно слово — оно значит и «здравствуй», и «отдохни»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สลักไว้ด้วยคำเพียงคำเดียวที่แปลได้ทั้งว่า สวัสดี และ พักเถิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üzerine hem “merhaba” hem “dinlen” anlamına gelen tek bir kelime kazınmış."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上面刻着一个词，既是“你好”，也是“歇一歇”。"
          }
        }
      }
    },
