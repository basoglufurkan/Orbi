            "value" : "Un solo pago. Sin suscripción ni renovaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul paiement. Pas d'abonnement, pas de renouvellement."
          }
        },
        "it" : {
          "stringUnit" : {
