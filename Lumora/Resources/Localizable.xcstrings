          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цепочка светящихся следов ведёт к лучшему месту, чтобы встретить рассвет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอยเท้าเรืองแสงที่นำทางไปยังจุดชมพระอาทิตย์ขึ้นที่งามที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün doğumunu izlemenin en güzel yerine götüren, ışıldayan ayak izlerinden bir patika."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一串发光的脚印，通往观赏日出的最佳地点。"
          }
        }
      }
    },
    "A vault of starseeds" : {
