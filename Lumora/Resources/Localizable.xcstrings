    "%@ is a wonder now. It shines across every galaxy you have ignited." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صار %@ أعجوبة. يسطع نوره في كل مجرّة أوقدتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist jetzt ein Wunder und leuchtet über alle Galaxien, die du entflammt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya es una maravilla. Brilla en todas las galaxias que has encendido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est désormais une merveille et brille dans toutes les galaxies que tu as embrasées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ora è una meraviglia. Risplende in ogni galassia che hai acceso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は奇跡の世界になりました。あなたが灯したすべての銀河に、その光が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, 이제 경이로운 세계가 되었어요. 지금껏 불을 밝힌 모든 은하에 그 빛이 닿아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agora é uma maravilha. Brilha em todas as galáxias que você acendeu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мир %@ стал чудом. Его сияние видно во всех зажжённых тобой галактиках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ กลายเป็นสิ่งมหัศจรรย์แล้ว แสงของมันส่องไปทั่วทุกกาแล็กซีที่คุณทำให้ลุกโชน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ artık bir harika. Tutuşturduğun her galakside parlıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已成为奇观，它的光芒照耀着你点亮的每一个星系。"
          }
        }
      }
    },
