    "Beyond every chart. Only your light has reached this far." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وراء كل الخرائط. لم يبلغ هذا المدى سوى ضوئك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenseits aller Karten. Nur dein Licht ist bis hierher gelangt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más allá de todos los mapas. Solo tu luz ha llegado tan lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de toutes les cartes. Seule ta lumière est arrivée jusqu’ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre ogni mappa. Solo la tua luce è arrivata fin qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆる星図の向こう。ここまで届いたのは、あなたの光だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 지도 너머. 이곳까지 닿은 건 오직 나의 빛뿐이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Além de todos os mapas. Só a sua luz chegou tão longe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За краем всех карт. Так далеко добрался лишь твой свет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พ้นไปจากแผนที่ทุกฉบับ มีเพียงแสงของคุณที่มาได้ไกลถึงเพียงนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün haritaların ötesinde. Buraya kadar yalnızca senin ışığın ulaştı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有星图之外。只有你的光抵达过这里。"
          }
        }
      }
    },
