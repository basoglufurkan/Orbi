    "Settle in. The light is gathering." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استقرّ. الضوء يتجمّع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm zur Ruhe. Das Licht sammelt sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acomódate. La luz se está reuniendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installe-toi. La lumière se rassemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenditi un momento. La luce si sta raccogliendo."
          }
