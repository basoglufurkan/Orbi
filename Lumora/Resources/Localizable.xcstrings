          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre se queda con tu Apple ID. Orbi no guarda ninguna cuenta en un servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton nom reste avec ton identifiant Apple. Orbi ne garde aucun compte sur un serveur."
