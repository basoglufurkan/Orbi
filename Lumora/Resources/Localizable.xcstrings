    "Turns off the next time you open Orbi. What's already in iCloud stays there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف في المرة القادمة التي تفتح فيها Orbi. ما هو موجود في iCloud يبقى هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim nächsten Öffnen von Orbi ausgeschaltet. Was schon in iCloud ist, bleibt dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactiva la próxima vez que abras Orbi. Lo que ya está en iCloud se queda allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se désactive à la prochaine ouverture de Orbi. Ce qui est déjà dans iCloud y reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si disattiva la prossima volta che apri Orbi. Ciò che è già in iCloud resta lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次にOrbiを開いたときにオフになります。すでにiCloudにあるデータはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 Orbi를 열 때 꺼져요. 이미 iCloud에 있는 데이터는 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa na próxima vez que você abrir o Orbi. O que já está no iCloud continua lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключится при следующем запуске Orbi. То, что уже в iCloud, там и останется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะปิดในครั้งถัดไปที่คุณเปิด Orbi ข้อมูลที่อยู่ใน iCloud แล้วจะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi'yi bir sonraki açışında kapanır. iCloud'da olanlar orada kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次打开 Orbi 时关闭。已在 iCloud 中的内容会保留。"
          }
        }
      }
    },
