    "You need %lld more stardust." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج إلى %lld أخرى من غبار النجوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst noch %lld Sternenstaub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas %lld de polvo estelar más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te faut encore %lld poussières d’étoiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti serve altra polvere di stelle: ancora %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星くずがあと%lld必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별가루가 %lld 더 필요해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de mais %lld de poeira estelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно ещё %lld звёздной пыли."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้ละอองดาวอีก %lld"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld yıldız tozuna daha ihtiyacın var."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还需要 %lld 星尘。"
          }
        }
      }
    },
    "You need %lld more stardust. Every focused minute adds some." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج إلى %lld أخرى من غبار النجوم. كل دقيقة تركيز تضيف بعضًا منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst noch %lld Sternenstaub. Jede Minute Fokus bringt etwas dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas %lld de polvo estelar más. Cada minuto de enfoque suma un poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te faut encore %lld poussières d’étoiles. Chaque minute de concentration en ajoute un peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti serve altra polvere di stelle: ancora %lld. Ogni minuto di concentrazione ne aggiunge un po'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星くずがあと%lld必要です。集中した1分ごとに、少しずつ増えていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별가루가 %lld 더 필요해요. 집중하는 1분마다 조금씩 쌓여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de mais %lld de poeira estelar. Cada minuto de foco soma um pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно ещё %lld звёздной пыли. Каждая минута фокуса добавляет немного."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้ละอองดาวอีก %lld ทุกนาทีที่โฟกัสจะเติมให้ทีละนิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld yıldız tozuna daha ihtiyacın var. Odaklandığın her dakika biraz daha ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还需要 %lld 星尘。每专注一分钟，都会多攒一些。"
          }
        }
      }
    },
    "You reached today's goal, %@! Anything more is a gift to your sky." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت إلى هدف اليوم يا %@! أي شيء إضافي هدية لسمائك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dein Tagesziel erreicht, %@! Alles Weitere ist ein Geschenk an deinen Himmel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Alcanzaste la meta de hoy, %@! Todo lo demás es un regalo para tu cielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objectif du jour atteint, %@ ! Tout le reste est un cadeau pour ton ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiettivo di oggi raggiunto, %@! Tutto il resto è un regalo al tuo cielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、今日の目標に届いたね！ここからは空へのおまけだよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 목표를 달성했어요, %@! 이제부터는 하늘에 주는 선물이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você atingiu a meta de hoje, %@! O resto é um presente para o seu céu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель на сегодня достигнута, %@! Всё остальное — подарок твоему небу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถึงเป้าหมายของวันนี้แล้ว %@ ที่เหลือคือของขวัญให้ท้องฟ้าของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü hedefine ulaştın, %@! Bundan sonrası gökyüzüne bir hediye."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，你达成了今天的目标！再多的都是送给天空的礼物。"
          }
        }
      }
    },
