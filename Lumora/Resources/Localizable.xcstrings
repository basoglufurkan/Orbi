    },
    "This is everything you've built. Pinch to zoom, drag to wander, and slide through your journey below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا كل ما بنيته. قرّب بإصبعين، واسحب للتجول، وتنقّل في رحلتك بالأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist alles, was du aufgebaut hast. Zum Zoomen auseinanderziehen, zum Erkunden ziehen und unten durch deine Reise gleiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es todo lo que has construido. Pellizca para hacer zoom, arrastra para explorar y recorre tu viaje abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici tout ce que tu as construit. Pince pour zoomer, fais glisser pour explorer, et parcours ton voyage en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è tutto ciò che hai costruito. Pizzica per ingrandire, trascina per esplorare e scorri il tuo viaggio qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これが、きみが築いてきたすべて。ピンチでズーム、ドラッグで散歩、下で旅をたどれるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 만든 모든 것이에요. 핀치로 확대하고, 드래그로 둘러보고, 아래에서 여정을 넘겨 봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é tudo o que você construiu. Faça pinça para ampliar, arraste para explorar e percorra sua jornada abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вот всё, что у тебя уже есть. Сведи пальцы для масштаба, веди, чтобы гулять, и листай путь внизу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือทุกสิ่งที่คุณสร้างมา จีบนิ้วเพื่อซูม ลากเพื่อสำรวจ และเลื่อนดูการเดินทางด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burası şimdiye kadar kurduğun her şey. Yakınlaştırmak için iki parmakla sıkıştır, gezinmek için sürükle, aşağıdan yolculuğunda ileri geri git."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这就是你创造的一切。双指缩放，拖动漫游，在下方回顾你的旅程。"
          }
        }
      }
    },
