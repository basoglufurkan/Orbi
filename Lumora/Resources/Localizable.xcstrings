    "Golden dunes roll like a sea that moves one grain at a time. The sand is warm and sings as you walk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثبان ذهبية تتموّج كبحر يتحرّك حبّةً حبّة. الرمل دافئ ويغنّي تحت خطاك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldene Dünen wogen wie ein Meer, das sich Korn für Korn bewegt. Der Sand ist warm und singt unter deinen Schritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunas doradas ondulan como un mar que avanza grano a grano. La arena es cálida y canta a tu paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des dunes dorées ondulent comme une mer qui avance grain par grain. Le sable est tiède et chante sous tes pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dune dorate ondeggiano come un mare che si muove un granello alla volta. La sabbia è tiepida e canta al tuo passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄金色の砂丘が、ひと粒ずつ動く海のようにうねっています。砂はあたたかく、歩くと歌います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "황금빛 모래언덕이 한 알씩 움직이는 바다처럼 굽이쳐요. 모래는 따뜻하고, 걸을 때마다 노래해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunas douradas ondulam como um mar que se move um grão de cada vez. A areia é morna e canta enquanto você caminha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Золотые дюны катятся, словно море, что движется по песчинке. Песок тёплый и поёт под ногами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนินทรายสีทองเป็นลอนคลื่นดั่งทะเลที่เคลื่อนไปทีละเม็ด ผืนทรายอบอุ่นและขับขานทุกครั้งที่คุณก้าวเดิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altın kumullar, tane tane ilerleyen bir deniz gibi dalgalanıyor. Kum sıcacık ve sen yürüdükçe şarkı söylüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金色的沙丘如海浪般起伏，一粒一粒地缓缓移动。沙子温暖，踩上去会轻轻歌唱。"
          }
        }
      }
    },
    "Golden seas of sand that move like water." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحار ذهبية من رمل تجري كالماء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldene Sandmeere, die fließen wie Wasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mares dorados de arena que se mueven como el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des mers de sable doré qui coulent comme de l’eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mari dorati di sabbia che si muovono come l'acqua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水のように流れる、黄金の砂の海。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물처럼 흐르는 황금빛 모래 바다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mares dourados de areia que se movem como água."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Золотые моря песка, текущие, как вода."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทะเลทรายสีทองที่เคลื่อนไหวดั่งสายน้ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su gibi akan altın kum denizleri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如水般流动的金色沙海。"
          }
        }
      }
    },
