    "Look back at any week or month, not just this one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعرض أي أسبوع أو شهر، لا الحالي فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blicke auf jede Woche und jeden Monat zurück, nicht nur auf diese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cualquier semana o mes, no solo el actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reviens sur n'importe quelle semaine ou n'importe quel mois, pas seulement l'actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riguarda qualsiasi settimana o mese, non solo quello attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週や今月だけでなく、どの週・月でも振り返れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주뿐 아니라 어느 주, 어느 달이든 돌아볼 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja qualquer semana ou mês, não só o atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри любую неделю или месяц, а не только текущие."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้อนดูสัปดาห์หรือเดือนใดก็ได้ ไม่ใช่แค่ช่วงนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece bu haftaya değil, istediğin hafta ya da aya geri bak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回顾任意一周或一个月，而不只是本周。"
          }
        }
      }
    },
