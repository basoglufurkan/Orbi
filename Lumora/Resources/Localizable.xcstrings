        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 세션이 쌓이고, 목표 시간에 도달하면 저절로 완료돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
