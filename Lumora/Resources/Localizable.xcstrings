    "Round, gentle creatures that eat only fallen starlight and purr when they are full." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخلوقات مستديرة وديعة لا تأكل إلا ضوء النجوم المتساقط، وتخرخر حين تشبع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde, sanfte Wesen, die nur heruntergefallenes Sternenlicht fressen und schnurren, wenn sie satt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criaturas redondas y mansas que solo comen luz de estrellas caída y ronronean cuando están llenas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De douces créatures toutes rondes qui ne mangent que la lumière tombée des étoiles et ronronnent une fois rassasiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creature tonde e mansuete che si nutrono solo di luce stellare caduta e fanno le fusa quando sono sazie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ちてきた星の光だけを食べ、おなかがいっぱいになるとのどを鳴らす、まるくておだやかな生きもの。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "떨어진 별빛만 먹고, 배가 부르면 가르랑거리는 동그랗고 순한 생명체."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criaturas redondas e mansas que só comem luz das estrelas caída e ronronam quando estão satisfeitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Круглые кроткие создания: едят только упавший звёздный свет и мурлычут, когда сыты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัตว์ตัวกลมแสนอ่อนโยนที่กินเพียงแสงดาวที่ร่วงหล่น และส่งเสียงครางเบา ๆ เมื่ออิ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca düşen yıldız ışığıyla beslenen, karınları doyunca mırlayan yuvarlak, uysal yaratıklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆滚滚的温顺生灵，只吃落下的星光，吃饱了就会发出呼噜声。"
          }
        }
      }
    },
