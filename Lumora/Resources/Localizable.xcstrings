    "Thank you. Your sky has everything it can hold." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكرًا لك. سماؤك تحمل كل ما تتسع له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke. Dein Himmel hat alles, was er fassen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias. Tu cielo tiene todo lo que puede albergar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci. Ton ciel a tout ce qu'il peut contenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie. Il tuo cielo ha tutto ciò che può contenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありがとう。あなたの空には、入るものがすべてそろいました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고마워요. 당신의 하늘은 담을 수 있는 모든 걸 품었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado. Seu céu tem tudo o que pode guardar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо. В твоём небе есть всё, что оно может вместить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอบคุณ ท้องฟ้าของคุณมีทุกสิ่งที่จะมีได้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teşekkürler. Gökyüzün sığdırabileceği her şeye sahip."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢谢你。你的星空已拥有它能容纳的一切。"
          }
        }
      }
    },
