    "A small step today, and its star burns a little brighter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوة صغيرة اليوم، فتتّقد نجمتها أكثر قليلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleiner Schritt heute, und ihr Stern brennt ein wenig heller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pequeño paso hoy, y su estrella arde un poco más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit pas aujourd’hui, et son étoile brille un peu plus fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un piccolo passo oggi, e la sua stella brilla un po' di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の小さな一歩で、その星は少しだけ明るく燃えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 작은 한 걸음으로 그 별이 조금 더 밝게 타올라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pequeno passo hoje, e a estrela dele brilha um pouco mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленький шаг сегодня — и её звезда горит чуть ярче."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก้าวเล็กๆ วันนี้ ทำให้ดาวของมันสว่างขึ้นอีกนิด"
          }
        },
        "tr" : {
          "stringUnit" : {
