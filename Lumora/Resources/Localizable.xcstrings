    "Rings like a clock alarm, even in Silent mode or a Focus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرنّ كمنبّه الساعة، حتى في الوضع الصامت أو عند تفعيل وضع تركيز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelt wie ein Wecker, auch im Stummmodus oder in einem Fokus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena como un despertador, incluso en modo silencio o en un modo de concentración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne comme un réveil, même en mode silencieux ou en mode Concentration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona come una sveglia, anche in modalità silenziosa o Full immersion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消音モードや集中モード中でも、時計のアラームのように鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음 모드나 집중 모드에서도 시계 알람처럼 울려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca como um alarme do Relógio, mesmo no modo Silencioso ou com um Foco ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звонит как будильник, даже в бесшумном режиме или в режиме фокусирования."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดังเหมือนนาฬิกาปลุก แม้อยู่ในโหมดเงียบหรือโหมดโฟกัส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat alarmı gibi çalar; Sessiz modda ya da bir Odak modundayken bile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在静音模式或专注模式下，也会像时钟闹钟一样响起。"
          }
        }
      }
    },
