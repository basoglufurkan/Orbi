          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один платёж. Без подписки и продлений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายครั้งเดียว ไม่มีการสมัครรับ ไม่มีการต่ออายุ"
          }
        },
        "tr" : {
