            "value" : "โลกนี้เป็นสิ่งมหัศจรรย์แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dünya zaten bir harika."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个世界已是奇观。"
          }
        }
      }
    },
    "Thousandfold" : {
      "localizations" : {
