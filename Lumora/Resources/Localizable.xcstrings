    "The ground is black glass, warm to the touch, and rivers of light move beneath it like slow thoughts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأرض زجاج أسود دافئ الملمس، وتحته تجري أنهار من نور كأفكار متمهّلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Boden ist schwarzes Glas, warm unter der Hand, und darunter ziehen Flüsse aus Licht wie langsame Gedanken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El suelo es de cristal negro, cálido al tacto, y bajo él se mueven ríos de luz como pensamientos lentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sol est de verre noir, tiède sous la main, et des rivières de lumière y circulent comme de lentes pensées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suolo è di vetro nero, tiepido al tatto, e sotto di esso scorrono fiumi di luce come pensieri lenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地面は黒いガラスで、触れるとあたたかく、その下を光の川がゆっくりとした思いのように流れています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "땅은 검은 유리라 만지면 따뜻하고, 그 아래로 빛의 강이 느린 생각처럼 흘러요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O chão é de vidro negro, morno ao toque, e rios de luz se movem por baixo dele como pensamentos lentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Земля здесь — чёрное стекло, тёплое на ощупь, и под ним, как неспешные мысли, текут реки света."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นดินเป็นแก้วสีดำ อุ่นเมื่อสัมผัส และเบื้องล่างมีสายธารแห่งแสงเคลื่อนไหวดั่งความคิดที่เชื่องช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zemin siyah camdan, dokununca sıcacık; altında ışık nehirleri ağır düşünceler gibi akıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大地是黑色的玻璃，触手温热，光之河在其下缓缓流动，如悠长的思绪。"
          }
        }
      }
    },
    "The highest rank. Every sky is yours to keep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى رتبة. كل السماوات لك إلى الأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der höchste Rang. Jeder Himmel gehört nun dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rango más alto. Todos los cielos son tuyos para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rang le plus élevé. Chaque ciel est désormais à toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grado più alto. Ogni cielo è tuo, per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高のランク。すべての空があなたのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 높은 등급. 이제 모든 하늘을 품었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A patente mais alta. Todos os céus são seus para sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высший ранг. Все небеса теперь твои."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระดับสูงสุด ท้องฟ้าทุกผืนเป็นของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En yüksek rütbe. Bütün gökler artık senin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高等级。每一片天空都归你所有。"
          }
        }
      }
    },
    "The humming obelisk" : {
