    "Welcome back, %@! Missed days only rest. Shall we light one more star?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أهلًا بعودتك يا %@! الأيام الفائتة تستريح فقط. هل نضيء نجمًا آخر؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen zurück, %@! Verpasste Tage ruhen nur. Zünden wir noch einen Stern an?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Qué bueno verte, %@! Los días perdidos solo descansan. ¿Encendemos otra estrella?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon retour, %@ ! Les jours manqués se reposent, c'est tout. On allume une étoile de plus ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che bello rivederti, %@! I giorni saltati riposano soltanto. Accendiamo un'altra stella?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おかえり、%@！休んだ日は、ただ休んでいただけ。もうひとつ星を灯そうか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 왔네요, %@! 놓친 날은 그저 쉬는 날이에요. 별 하나 더 밝혀 볼까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que bom te ver de volta, %@! Dias perdidos apenas descansam. Vamos acender mais uma estrela?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С возвращением, %@! Пропущенные дни просто отдыхают. Зажжём ещё одну звезду?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยินดีต้อนรับกลับ %@ วันที่พลาดไปก็แค่ได้พัก มาจุดดาวอีกดวงกันไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar hoş geldin, %@! Kaçırılan günler yalnızca dinlenir. Bir yıldız daha yakalım mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎回来，%@！错过的日子只是在休息。我们再点亮一颗星吧？"
          }
        }
      }
    },
