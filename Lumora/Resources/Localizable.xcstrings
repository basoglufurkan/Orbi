            "value" : "第二片星域为你开启。"
          }
        }
      }
    },
    "A session is already running. End it to focus together." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك جلسة جارية بالفعل. أنهِها لتركّزوا معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft bereits eine Sitzung. Beende sie, um gemeinsam zu fokussieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una sesión en curso. Termínala para concentraros juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session est déjà en cours. Termine-la pour te concentrer ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è già una sessione in corso. Terminala per concentrarvi insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにセッションが進行中です。一緒に集中するには、それを終えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 진행 중인 세션이 있어요. 함께 집중하려면 먼저 끝내세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já há uma sessão em andamento. Encerre-a para focar juntos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессия уже идёт. Завершите её, чтобы фокусироваться вместе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเซสชันที่กำลังดำเนินอยู่แล้ว จบเซสชันนั้นก่อนเพื่อโฟกัสด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten süren bir seans var. Birlikte odaklanmak için onu bitir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有一个专注正在进行。结束后即可一起专注。"
          }
        }
      }
    },
