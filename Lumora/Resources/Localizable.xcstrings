    "Your sky is\ngrowing today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سماؤك\nتكبر اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
