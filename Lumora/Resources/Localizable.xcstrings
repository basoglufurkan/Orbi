    "Starts a 15, 25, 45 or 60 minute Orbi focus session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ جلسة تركيز في Orbi مدتها 15 أو 25 أو 45 أو 60 دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine Orbi-Fokus-Session mit 15, 25, 45 oder 60 Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una sesión de enfoque de Orbi de 15, 25, 45 o 60 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance une séance de concentration Orbi de 15, 25, 45 ou 60 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una sessione di concentrazione Orbi da 15, 25, 45 o 60 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15・25・45・60分のOrbi集中セッションを開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15, 25, 45, 60분 Orbi 집중 세션을 시작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia uma sessão de foco de 15, 25, 45 ou 60 minutos no Orbi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает фокус-сессию Orbi на 15, 25, 45 или 60 минут."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเซสชันโฟกัสของ Orbi 15, 25, 45 หรือ 60 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15, 25, 45 ya da 60 dakikalık bir Orbi odak seansı başlatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始一次 15、25、45 或 60 分钟的 Orbi 专注。"
          }
        }
      }
    },
    "Starts a focus session with your usual length, or ends the one that's running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ جلسة تركيز بمدّتك المعتادة، أو يُنهي الجلسة الجارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine Fokus-Session mit deiner üblichen Länge oder beendet die laufende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una sesión de enfoque con tu duración habitual o termina la que está en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance une séance de concentration de ta durée habituelle, ou termine celle en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una sessione di concentrazione con la tua durata abituale o termina quella in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの長さで集中セッションを始めるか、進行中のセッションを終えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소 길이로 집중 세션을 시작하거나 진행 중인 세션을 끝내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia uma sessão de foco com a sua duração de sempre ou encerra a que está em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает сессию фокуса привычной длины или завершает текущую."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเซสชันโฟกัสด้วยความยาวที่คุณใช้ประจำ หรือจบเซสชันที่กำลังดำเนินอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her zamanki sürenle bir odak seansı başlatır ya da süren seansı bitirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以你惯用的时长开始一次专注，或结束正在进行的专注。"
          }
        }
      }
    },
    "Starts an Orbi focus session without opening the app. Uses your default length and last category unless you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ جلسة تركيز في Orbi دون فتح التطبيق. ويستخدم مدتك الافتراضية وآخر فئة ما لم تختر غير ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine Orbi-Fokus-Session, ohne die App zu öffnen. Verwendet deine Standardlänge und letzte Kategorie, sofern du nichts anderes wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una sesión de enfoque de Orbi sin abrir la app. Usa tu duración predeterminada y tu última categoría, salvo que elijas otras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance une séance de concentration Orbi sans ouvrir l’app. Utilise ta durée par défaut et ta dernière catégorie, sauf si tu en choisis d’autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una sessione di concentrazione Orbi senza aprire l'app. Usa la durata predefinita e l'ultima categoria, a meno che tu non scelga diversamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開かずにOrbiの集中セッションを開始します。指定しなければ、デフォルトの長さと前回のカテゴリを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열지 않고 Orbi 집중 세션을 시작해요. 따로 선택하지 않으면 기본 길이와 지난번 카테고리를 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia uma sessão de foco no Orbi sem abrir o app. Usa sua duração padrão e a última categoria, a menos que você escolha outras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает фокус-сессию Orbi, не открывая приложение. Использует длительность по умолчанию и последнюю категорию, если ты не выберешь другие."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเซสชันโฟกัสของ Orbi โดยไม่ต้องเปิดแอป จะใช้ความยาวเริ่มต้นและหมวดหมู่ล่าสุด หากคุณไม่ได้เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı açmadan bir Orbi odak seansı başlatır. Sen seçmedikçe varsayılan süreni ve son kategorini kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需打开 App 即可开始 Orbi 专注。若未另行选择，将使用默认时长和上次的类别。"
          }
        }
      }
    },
