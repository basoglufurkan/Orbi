    "Sky themes, every soundscape and your whole history open up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح سمات السماء وكل الأجواء الصوتية وسجلك الكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmelsthemen, alle Klangwelten und dein ganzer Verlauf werden freigeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desbloquean los temas del cielo, todos los paisajes sonoros y todo tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les thèmes du ciel, toutes les ambiances sonores et tout ton historique s'ouvrent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sbloccano i temi del cielo, tutti i paesaggi sonori e tutta la tua cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のテーマ、すべてのサウンドスケープ、すべての履歴が使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하늘 테마, 모든 사운드스케이프, 전체 기록이 열려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temas do céu, todas as paisagens sonoras e todo o seu histórico ficam disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открываются темы неба, все звуковые пейзажи и вся ваша история."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลดล็อกธีมท้องฟ้า เสียงบรรยากาศทุกแบบ และประวัติทั้งหมดของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gökyüzü temaları, tüm ses manzaraları ve geçmişinin tamamı açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁天空主题、全部声景和你的完整历史。"
          }
        }
      }
    },
    "Sky themes, every soundscape, rare ship finishes and your whole history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمات السماء وكل الأجواء الصوتية وتشطيبات نادرة للمركبة وسجلك كاملًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmelsthemen, alle Klangwelten, seltene Schiffslackierungen und deine ganze Geschichte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temas del cielo, todos los paisajes sonoros, acabados de nave raros y todo tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thèmes du ciel, toutes les ambiances, finitions de vaisseau rares et tout ton historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temi del cielo, tutti i paesaggi sonori, finiture rare per la nave e tutta la tua cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のテーマ、すべてのサウンドスケープ、レアな船の仕上げ、そしてすべての履歴。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하늘 테마, 모든 사운드스케이프, 희귀한 우주선 마감, 그리고 전체 기록."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temas do céu, todas as paisagens sonoras, acabamentos raros de nave e todo o seu histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Темы неба, все звуковые пейзажи, редкие отделки корабля и вся твоя история."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ธีมท้องฟ้า เสียงบรรยากาศทั้งหมด ลวดลายยานหายาก และประวัติทั้งหมดของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gökyüzü temaları, tüm ses manzaraları, nadir gemi kaplamaları ve tüm geçmişin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星空主题、全部环境音、稀有飞船涂装，以及你的完整历史。"
          }
        }
      }
    },
