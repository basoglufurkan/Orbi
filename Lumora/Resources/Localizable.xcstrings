    "Ten hours, and the whole sky is a little warmer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشر ساعات، وصارت السماء كلها أدفأ قليلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Stunden, und der ganze Himmel ist ein wenig wärmer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diez horas, y todo el cielo está un poco más cálido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dix heures, et tout le ciel est un peu plus chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieci ore, e tutto il cielo è un po' più caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10時間。空全体が、少しあたたかくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10시간. 하늘 전체가 조금 더 따뜻해졌어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dez horas, e o céu inteiro está um pouco mais quente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Десять часов — и всё небо стало чуть теплее."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิบชั่วโมง และท้องฟ้าทั้งผืนก็อบอุ่นขึ้นอีกนิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On saat ve bütün gökyüzü biraz daha sıcak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十个小时，整片天空都温暖了一些。"
          }
        }
      }
    },
    "Ten sessions, and your first planet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشر جلسات، وكوكبك الأول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Sitzungen, und dein erster Planet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diez sesiones y tu primer planeta."
          }
        },
        "fr" : {
          "stringUnit" : {
