    "Thousands of tiny embers fall through the night, each one a wish someone forgot to make." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلاف الجمرات الصغيرة تتساقط عبر الليل، كلٌّ منها أمنية نسي أحدهم أن يتمنّاها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausende winziger Glutfunken fallen durch die Nacht, jeder ein Wunsch, den jemand auszusprechen vergaß."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miles de diminutas ascuas caen en la noche, cada una un deseo que alguien olvidó pedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des milliers de petites braises tombent dans la nuit, chacune un vœu que quelqu’un a oublié de faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliaia di piccole braci cadono nella notte, ognuna un desiderio che qualcuno ha dimenticato di esprimere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無数の小さな火の粉が夜を降りてきます。ひとつひとつが、誰かが願い忘れた願いごと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수천 개의 작은 불씨가 밤하늘을 가로질러 떨어져요. 하나하나가 누군가 빌기를 잊은 소원이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milhares de pequenas brasas caem pela noite, cada uma um desejo que alguém esqueceu de fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тысячи крошечных искр падают сквозь ночь — и каждая из них желание, которое кто-то забыл загадать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประกายไฟเล็ก ๆ นับพันร่วงหล่นผ่านรัตติกาล แต่ละดวงคือคำอธิษฐานที่ใครบางคนลืมเอ่ย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binlerce minik kor gecenin içinden düşer; her biri, birinin dilemeyi unuttuğu bir dilek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成千上万颗细小的余烬穿过夜空飘落，每一颗都是有人忘了许下的愿望。"
          }
        }
      }
    },
    "Thousands of tiny glass jars, each holding one small star, fast asleep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلاف الجرار الزجاجية الصغيرة، في كل منها نجمة صغيرة غارقة في النوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausende winzige Gläser, und in jedem schläft tief und fest ein kleiner Stern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miles de frasquitos de cristal, cada uno con una pequeña estrella profundamente dormida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des milliers de minuscules bocaux de verre, chacun abritant une petite étoile profondément endormie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliaia di minuscoli barattoli di vetro, ognuno con dentro una piccola stella profondamente addormentata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何千もの小さなガラス瓶。そのひとつひとつで、小さな星がぐっすり眠っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수천 개의 작은 유리병. 병마다 작은 별 하나가 곤히 잠들어 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milhares de potinhos de vidro, cada um guardando uma estrelinha em sono profundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тысячи крошечных стеклянных баночек, и в каждой крепко спит маленькая звезда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลแก้วจิ๋วนับพัน แต่ละใบมีดาวดวงน้อยหลับใหลอยู่หนึ่งดวง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binlerce minik cam kavanoz; her birinde mışıl mışıl uyuyan küçük bir yıldız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成千上万个小玻璃罐，每个里面都装着一颗小星星，睡得正香。"
          }
        }
      }
    },
