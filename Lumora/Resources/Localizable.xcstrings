    "Deep violet dust swallows light, then gives it back as auroras." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غبار بنفسجي عميق يبتلع الضوء، ثم يعيده شفقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefvioletter Staub verschluckt das Licht und schenkt es als Polarlichter zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un polvo violeta intenso se traga la luz y luego la devuelve en forma de auroras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une poussière d’un violet profond avale la lumière, puis la rend en aurores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una polvere viola intenso inghiotte la luce e poi la restituisce in forma di aurore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深いすみれ色の塵が光をのみこみ、オーロラにして返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짙은 보랏빛 먼지가 빛을 삼켰다가 오로라로 돌려줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma poeira violeta profunda engole a luz e depois a devolve em forma de auroras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Густая фиолетовая пыль поглощает свет, а потом возвращает его полярными сияниями."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฝุ่นสีม่วงเข้มกลืนกินแสง แล้วคืนกลับมาเป็นแสงออโรรา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
