    "Orbi %@ · Your universe lives in your private iCloud." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · كونك يعيش في iCloud الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Dein Universum lebt in deiner privaten iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Tu universo vive en tu iCloud privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Ton univers vit dans ton iCloud privé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Il tuo universo vive nel tuo iCloud privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · あなたの宇宙はあなた専用のiCloudにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · 우주는 나만의 iCloud에 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Seu universo vive no seu iCloud privado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Твоя вселенная живёт в твоём личном iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · จักรวาลของคุณอยู่ใน iCloud ส่วนตัวของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Evrenin kendi özel iCloud'unda yaşıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · 你的宇宙保存在你的私人 iCloud 中。"
          }
        }
      }
    },
    "Orbi %@ · Your universe lives on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · كونك يعيش على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Dein Universum lebt auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Tu universo vive en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Ton univers vit sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbi %@ · Il tuo universo vive su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
