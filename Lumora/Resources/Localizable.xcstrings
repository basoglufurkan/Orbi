    "After that it's %@ a year. To cancel, go to Settings › Apple Account › Subscriptions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ذلك يصبح السعر %@ سنويًا. للإلغاء، انتقل إلى الإعدادات › حساب Apple › الاشتراكات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach kostet es %@ pro Jahr. Zum Kündigen: Einstellungen › Apple Account › Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después cuesta %@ al año. Para cancelar, ve a Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, c'est %@ par an. Pour résilier, va dans Réglages › Compte Apple › Abonnements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo costa %@ all'anno. Per annullare, vai in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後は年額%@です。解約は「設定」›「Appleアカウント」›「サブスクリプション」から。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이후에는 연 %@입니다. 취소하려면 설정 › Apple 계정 › 구독으로 이동하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois, custa %@ por ano. Para cancelar, vá em Ajustes › Conta Apple › Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем — %@ в год. Отменить можно в Настройках › Аккаунт Apple › Подписки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังจากนั้นราคา %@ ต่อปี หากต้องการยกเลิก ไปที่ การตั้งค่า › บัญชี Apple › การสมัครรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonrasında yıllık %@. İptal etmek için Ayarlar › Apple Hesabı › Abonelikler'e git."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后每年 %@。如需取消，请前往“设置”›“Apple 账户”›“订阅”。"
          }
        }
      }
    },
