    "For one night the far worlds stand in a single line, as if waiting for someone to notice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لليلة واحدة تقف العوالم البعيدة في خط واحد، كأنها تنتظر من يلاحظها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Nacht lang stehen die fernen Welten in einer Linie, als warteten sie darauf, bemerkt zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una noche, los mundos lejanos se ponen en fila, como esperando que alguien lo note."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps d’une nuit, les mondes lointains s’alignent, comme s’ils attendaient qu’on les remarque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una notte i mondi lontani si mettono in fila, come se aspettassero che qualcuno se ne accorga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一夜だけ、遠い世界が一列に並びます。誰かが気づくのを待っているかのように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단 하룻밤, 먼 세계들이 한 줄로 늘어서요. 누군가 알아봐 주길 기다리는 것처럼."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por uma noite, os mundos distantes ficam em linha, como se esperassem alguém notar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На одну ночь далёкие миры выстраиваются в линию, будто ждут, что кто-то это заметит."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพียงคืนเดียว โลกที่อยู่ไกลออกไปจะเรียงตัวเป็นเส้นเดียว ราวกับรอให้ใครสักคนสังเกตเห็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir gecelik uzak dünyalar tek bir çizgide dizilir, sanki biri fark etsin diye bekler gibi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一夜，遥远的世界排成一线，仿佛在等谁注意到。"
          }
        }
      }
    },
