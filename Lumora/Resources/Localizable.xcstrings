    "Tiny lights drift through the warm water, and the reefs answer them in colour." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضواء صغيرة تنساب في الماء الدافئ، والشِّعاب تجيبها بالألوان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winzige Lichter treiben durch das warme Wasser, und die Riffe antworten in Farben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucecitas flotan en el agua tibia, y los arrecifes les responden con colores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De minuscules lumières dérivent dans l’eau tiède, et les récifs leur répondent en couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuscole luci fluttuano nell'acqua tiepida, e le barriere coralline rispondono con i loro colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あたたかな水の中を小さな光が漂い、サンゴ礁が色でそれにこたえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따뜻한 물속을 작은 빛들이 떠다니고, 산호초가 색으로 화답해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luzinhas flutuam pela água morna, e os recifes respondem em cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тёплой воде плывут крошечные огоньки, и рифы отвечают им цветом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงดวงจิ๋วล่องลอยในน้ำอุ่น และแนวปะการังตอบกลับด้วยสีสัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilık suda minik ışıklar süzülüyor, resifler onlara renklerle karşılık veriyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细小的光点在温暖的海水中漂流，珊瑚礁以色彩回应它们。"
          }
        }
      }
    },
