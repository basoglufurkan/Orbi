        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его сессии фокуса и звёзды останутся в твоей вселенной."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันโฟกัสและดาวของบล็อกนี้ยังคงอยู่ในจักรวาลของคุณ"
