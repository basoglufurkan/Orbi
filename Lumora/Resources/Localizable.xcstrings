    "Focus sessions count toward it, and it's kept by itself once you reach the minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب لها جلسات التركيز، وتتمّ تلقائيًا حين تبلغ الدقائق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus-Sessions zählen dazu, und sobald du die Minuten erreichst, ist sie von selbst geschafft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones de enfoque suman, y se cumple solo cuando llegas a los minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes séances de concentration comptent, et elle est tenue d’elle-même une fois les minutes atteintes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni di concentrazione contano, e si completa da sola quando raggiungi i minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中セッションが加算され、目標の分数に届くと自動で達成になります。"
