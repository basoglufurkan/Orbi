            "value" : "Hundert Fokus-Sessions. Hundert kleine Sonnen, jede davon etwas, das du gewählt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cien sesiones de enfoque. Cien pequeños soles, cada uno algo que elegiste hacer."
