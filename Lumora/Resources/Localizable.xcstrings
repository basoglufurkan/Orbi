      }
    },
    "Seas, rivers or streams of light begin to move across the surface." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحار أو أنهار أو جداول من نور تبدأ بالجريان على السطح."
          }
        },
        "de" : {
          "stringUnit" : {
