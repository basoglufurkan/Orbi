    "Something is out there. Its light reached you first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثمة شيء هناك. وصلك ضوؤه أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da draußen ist etwas. Sein Licht hat dich zuerst erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay algo ahí fuera. Su luz te alcanzó primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose est là-bas. Sa lumière t’est parvenue la première."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è qualcosa là fuori. La sua luce ti ha raggiunto per prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向こうに何かがあります。その光が、先にあなたのもとへ届きました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저 너머에 무언가 있어요. 그 빛이 먼저 닿았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem algo lá fora. A luz dele chegou até você primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Там что-то есть. Его свет долетел до тебя первым."
