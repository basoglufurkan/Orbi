    "Nice to meet you, %@! Tap any light in your sky to see the session that made it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشرفت بمعرفتك يا %@! المس أي ضوء في سمائك لترى الجلسة التي صنعته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schön, dich kennenzulernen, %@! Tippe auf ein Licht an deinem Himmel, um die Sitzung dahinter zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Un placer conocerte, %@! Toca cualquier luz de tu cielo para ver la sesión que la creó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravi de te rencontrer, %@ ! Touche une lumière de ton ciel pour voir la séance qui l'a créée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piacere di conoscerti, %@! Tocca una luce nel tuo cielo per vedere la sessione che l'ha creata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしくね、%@！空の光にふれると、それを生んだセッションが見られるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만나서 반가워요, %@! 하늘의 빛을 눌러 그 빛을 만든 세션을 봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazer em te conhecer, %@! Toque em qualquer luz do seu céu para ver a sessão que a criou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приятно познакомиться, %@! Коснись любого огонька в небе, чтобы увидеть сессию, которая его зажгла."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยินดีที่ได้รู้จัก %@ แตะแสงใดก็ได้บนท้องฟ้าเพื่อดูเซสชันที่สร้างมัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanıştığıma memnun oldum, %@! Gökyüzündeki herhangi bir ışığa dokun, onu yaratan seansı gör."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高兴认识你，%@！点一下天空中的任意光点，就能看到它来自哪次专注。"
          }
        }
      }
    },
    "Night" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
