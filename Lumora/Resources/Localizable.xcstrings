    "Born from %lld sessions of light. A place you can return to forever." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وُلدت من ضوء %lld جلسات. مكان يمكنك العودة إليه إلى الأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entstanden aus %lld Sessions voller Licht. Ein Ort, zu dem du immer zurückkehren kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacido de %lld sesiones de luz. Un lugar al que siempre puedes volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Née de %lld séances de lumière. Un lieu où revenir pour toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nato da %lld sessioni di luce. Un luogo in cui tornare per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldセッション分の光から生まれました。いつでも帰ってこられる場所です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 %lld번의 빛에서 태어났어요. 언제든 돌아올 수 있는 곳이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascido de %lld sessões de luz. Um lugar para onde você pode voltar para sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из %lld сессий света. Место, куда можно возвращаться всегда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถือกำเนิดจากแสงของ %lld เซสชัน ที่ที่คุณกลับมาได้ตลอดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld seanslık ışıktan doğdu. Sonsuza dek dönebileceğin bir yer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %lld 次专注的光孕育而生，一个你可以永远回来的地方。"
          }
        }
      }
    },
    "Brass valleys tick softly in the evening light. The whole planet keeps perfect time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أودية نحاسية تتكتك بهدوء في ضوء المساء. الكوكب كله يضبط الوقت بدقّة تامة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messingtäler ticken leise im Abendlicht. Der ganze Planet geht auf die Sekunde genau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valles de latón hacen tictac suavemente a la luz del atardecer. Todo el planeta marca la hora exacta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des vallées de laiton font un doux tic-tac dans la lumière du soir. Toute la planète est réglée à la seconde près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valli d'ottone ticchettano piano nella luce della sera. L'intero pianeta segna il tempo alla perfezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕暮れの光の中で、真鍮の谷がやさしく時を刻みます。惑星全体が、寸分の狂いもなく時を守っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁 햇살 속에서 황동 골짜기가 조용히 째깍여요. 행성 전체가 한 치의 오차도 없이 시간을 지켜요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vales de latão fazem tique-taque baixinho na luz do entardecer. O planeta inteiro marca o tempo com perfeição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Латунные долины тихо тикают в вечернем свете. Вся планета идёт минута в минуту."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หุบเขาทองเหลืองดังติ๊กแผ่วเบาในแสงยามเย็น ทั้งดาวเดินตรงเวลาอย่างไม่ผิดเพี้ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirinç vadiler akşam ışığında usulca tıkırdıyor. Bütün gezegen zamanı kusursuz tutuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄铜山谷在暮光中轻轻滴答作响。整颗星球的时间分秒不差。"
          }
        }
      }
    },
