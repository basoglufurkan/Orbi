    "Night never quite falls here. The volcanoes glow a gentle orange, like coals in a quiet hearth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحلّ الليل هنا تمامًا. تتوهّج البراكين ببرتقالي رقيق، كجمر في موقد هادئ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz Nacht wird es hier nie. Die Vulkane glühen in sanftem Orange, wie Kohlen in einem stillen Herd."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí la noche nunca llega del todo. Los volcanes brillan con un naranja suave, como brasas en un hogar tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, la nuit ne tombe jamais tout à fait. Les volcans rougeoient d’un orange tendre, comme des braises dans un âtre paisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui la notte non scende mai del tutto. I vulcani brillano di un arancio tenue, come braci in un focolare silenzioso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは夜がすっかり訪れることはありません。火山はやさしいオレンジ色に光ります。静かな炉の熾火のように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳엔 밤이 완전히 찾아오지 않아요. 화산들이 고요한 화롯불의 숯처럼 은은한 주황빛으로 빛나요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui a noite nunca cai de verdade. Os vulcões brilham num laranja suave, como brasas numa lareira tranquila."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночь здесь так и не наступает. Вулканы мягко светятся оранжевым, как угли в тихом очаге."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่นี่ไม่เคยมืดสนิท ภูเขาไฟเรืองแสงสีส้มอ่อนโยน ดั่งถ่านในเตาผิงอันเงียบสงบ"
          }
        },
        "tr" : {
