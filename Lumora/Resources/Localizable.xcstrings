    "Its focus sessions and stars stay in your universe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى جلسات التركيز ونجومها في كونك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Fokus-Sessions und Sterne bleiben in deinem Universum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus sesiones de enfoque y sus estrellas se quedan en tu universo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses séances de concentration et ses étoiles restent dans ton univers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue sessioni di concentrazione e le sue stelle restano nel tuo universo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その集中セッションと星は、あなたの宇宙に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 세션과 별은 우주에 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões de foco e as estrelas dele continuam no seu universo."
