    "Choose a length and what you'll work on, %@. I'll be right here until your star is born." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المدة وما ستعمل عليه يا %@. سأبقى هنا حتى يولد نجمك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Dauer und woran du arbeitest, %@. Ich bin hier, bis dein Stern geboren ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una duración y en qué vas a trabajar, %@. Estaré aquí hasta que nazca tu estrella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis une durée et ce sur quoi tu vas travailler, %@. Je reste là jusqu'à la naissance de ton étoile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una durata e su cosa lavorerai, %@. Resto qui finché non nasce la tua stella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、長さと取り組むことを選んでね。星が生まれるまでここにいるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, 시간과 할 일을 골라요. 별이 태어날 때까지 여기 있을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma duração e no que vai trabalhar, %@. Fico aqui até sua estrela nascer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери длительность и над чем будешь работать, %@. Я буду рядом, пока не родится твоя звезда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระยะเวลาและสิ่งที่จะทำนะ %@ ฉันจะอยู่ตรงนี้จนกว่าดาวของคุณจะเกิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süre ve ne üzerinde çalışacağını seç, %@. Yıldızın doğana kadar buradayım."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，选好时长和要做的事。你的星星诞生前，我都在这儿。"
          }
        }
      }
    },
    "Choose a length and what you'll work on, %@. Want fewer distractions? Quiet your apps below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المدة وما ستعمل عليه يا %@. تريد تشتيتًا أقل؟ أسكِت تطبيقاتك بالأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Dauer und woran du arbeitest, %@. Weniger Ablenkung? Bring deine Apps unten zum Schweigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una duración y en qué vas a trabajar, %@. ¿Menos distracciones? Silencia tus apps abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis une durée et ce sur quoi tu vas travailler, %@. Moins de distractions ? Fais taire tes apps plus bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una durata e su cosa lavorerai, %@. Meno distrazioni? Silenzia le tue app qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、長さと取り組むことを選んでね。気が散るのを減らしたい？下でアプリを静かにできるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, 시간과 할 일을 골라요. 방해를 줄이고 싶다면 아래에서 앱을 조용히 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma duração e no que vai trabalhar, %@. Menos distrações? Silencie seus apps abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери длительность и над чем будешь работать, %@. Меньше отвлечений? Приглуши приложения ниже."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระยะเวลาและสิ่งที่จะทำนะ %@ อยากให้สิ่งรบกวนน้อยลงไหม ปิดเสียงแอปได้ด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süre ve ne üzerinde çalışacağını seç, %@. Daha az dikkat dağınıklığı mı? Uygulamalarını aşağıdan sustur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，选好时长和要做的事。想少些干扰？在下面让应用安静下来。"
          }
        }
      }
    },
