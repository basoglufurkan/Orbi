    "Paint your sky in aurora, ember, ocean or eclipse light." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوّن سماءك بضوء الشفق أو الجمر أو المحيط أو الكسوف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tauche deinen Himmel in Polarlicht, Glut, Ozean oder Finsternis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta tu cielo con luz de aurora, brasa, océano o eclipse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peins ton ciel d'aurore, de braise, d'océan ou d'éclipse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipingi il tuo cielo di aurora, brace, oceano o eclissi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空をオーロラ、残り火、オーシャン、日食の光で彩ろう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하늘을 오로라, 잉걸불, 바다, 일식의 빛으로 물들여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinte seu céu com luz de aurora, brasa, oceano ou eclipse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окрась небо в цвета сияния, углей, океана или затмения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่งท้องฟ้าด้วยแสงออโรรา ถ่านแดง มหาสมุทร หรือสุริยุปราคา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gökyüzünü aurora, kor, okyanus ya da tutulma ışığına boya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用极光、余烬、海洋或日食之光点染你的星空。"
          }
        }
      }
    },
    "Painted by a week of rhythm. Consistency, not volume, colors the sky." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوّنه أسبوع من الإيقاع. الاستمرار، لا الكثرة، هو ما يلوّن السماء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemalt von einer Woche im Rhythmus. Beständigkeit, nicht Menge, färbt den Himmel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintada por una semana de ritmo. La constancia, no la cantidad, colorea el cielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peinte par une semaine de rythme. C’est la régularité, pas la quantité, qui colore le ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipinta da una settimana di ritmo. È la costanza, non la quantità, a colorare il cielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1週間のリズムが描いたもの。空を彩るのは量ではなく、続けることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일주일의 리듬이 그려 냈어요. 하늘을 물들이는 건 양이 아니라 꾸준함이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintada por uma semana de ritmo. Constância, não volume, colore o céu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окрашена неделей ритма. Небо красит постоянство, а не объём."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่งแต้มด้วยจังหวะตลอดหนึ่งสัปดาห์ ความสม่ำเสมอ ไม่ใช่ปริมาณ คือสิ่งที่ระบายสีท้องฟ้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir haftalık ritimle boyandı. Gökyüzünü miktar değil, süreklilik renklendirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由一周的节律绘成。为天空着色的是坚持，而非数量。"
          }
        }
      }
    },
