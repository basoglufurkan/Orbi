    "Your focus will power the journey. Each minute brings your ship closer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيحرّك تركيزك الرحلة. كل دقيقة تقرّب سفينتك أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Fokus treibt die Reise an. Jede Minute bringt dein Schiff näher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu enfoque impulsará el viaje. Cada minuto acerca un poco más tu nave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta concentration alimentera le voyage. Chaque minute rapproche ton vaisseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua concentrazione alimenterà il viaggio. Ogni minuto avvicina la tua nave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの集中が旅の力になります。1分ごとに、船は少しずつ近づいていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중이 여정의 힘이 돼요. 1분마다 우주선이 조금씩 가까워져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu foco vai impulsionar a viagem. Cada minuto deixa sua nave mais perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Корабль полетит на силе твоего фокуса. Каждая минута приближает его к цели."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การโฟกัสของคุณจะขับเคลื่อนการเดินทาง ทุกนาทีพายานเข้าใกล้ขึ้นอีกนิด"
