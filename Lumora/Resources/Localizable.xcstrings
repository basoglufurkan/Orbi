    },
    "One payment. No subscription, no renewals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دفعة واحدة. بلا اشتراك ولا تجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
