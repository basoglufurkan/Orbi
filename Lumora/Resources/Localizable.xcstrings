    "The air is so clear that the stars stay out all day, just a little paler." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهواء صافٍ حتى إن النجوم تبقى ظاهرة طوال النهار، أبهت قليلًا فحسب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Luft ist so klar, dass die Sterne den ganzen Tag zu sehen sind, nur ein wenig blasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aire es tan limpio que las estrellas se quedan todo el día, solo un poco más pálidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’air est si pur que les étoiles restent visibles toute la journée, juste un peu plus pâles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aria è così limpida che le stelle restano visibili tutto il giorno, solo un po' più pallide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空気がとても澄んでいるので、星は一日じゅう空に残っています。ほんの少し、淡くなるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공기가 무척 맑아서 별이 하루 종일 떠 있어요. 조금 옅어질 뿐이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ar é tão limpo que as estrelas ficam no céu o dia todo, só um pouco mais pálidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воздух так прозрачен, что звёзды не гаснут весь день — лишь чуть бледнеют."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อากาศใสจนดวงดาวยังคงปรากฏตลอดทั้งวัน เพียงแค่จางลงเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava öyle berrak ki yıldızlar bütün gün gökte kalıyor, yalnızca biraz daha soluk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空气澄澈得星星整天都在，只是稍稍淡了一些。"
          }
        }
      }
    },
    "The App Store isn't reachable right now. Try again in a moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الوصول إلى App Store الآن. حاول مجددًا بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store ist gerade nicht erreichbar. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al App Store ahora. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
