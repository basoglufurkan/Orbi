    "Lightning flickers deep in the clouds, soft as a heartbeat, and the whole sky glows amber." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يومض البرق في أعماق الغيوم، ناعمًا كنبضة قلب، وتتوهّج السماء كلها بلون الكهرمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tief in den Wolken flackern Blitze, sanft wie ein Herzschlag, und der ganze Himmel glüht bernsteinfarben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los relámpagos parpadean en lo hondo de las nubes, suaves como un latido, y todo el cielo se tiñe de ámbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des éclairs vacillent au cœur des nuages, doux comme un battement de cœur, et tout le ciel rougeoie d’ambre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I lampi tremolano nel profondo delle nubi, lievi come un battito del cuore, e tutto il cielo si accende d'ambra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲の奥深くで、鼓動のようにやわらかく稲妻がまたたき、空いっぱいが琥珀色に光ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구름 깊은 곳에서 심장 박동처럼 부드럽게 번개가 깜빡이고, 온 하늘이 호박색으로 빛나요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâmpagos piscam no fundo das nuvens, suaves como uma batida do coração, e o céu inteiro brilha cor de âmbar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В глубине облаков мерцают молнии, мягкие, как стук сердца, и всё небо светится янтарём."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายฟ้าวาบไหวอยู่ลึกในหมู่เมฆ แผ่วเบาดั่งจังหวะหัวใจ และทั้งท้องฟ้าเรืองรองเป็นสีอำพัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulutların derininde şimşekler bir kalp atışı kadar yumuşak titreşiyor ve bütün gök kehribar rengiyle parlıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闪电在云层深处闪烁，轻柔如心跳，整片天空泛着琥珀色的光。"
          }
        }
      }
    },
    "Lightning takes almost a minute to cross the sky, so you can watch every branch unfold." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستغرق البرق قرابة دقيقة ليعبر السماء، فترى كل فرع منه وهو يتفتّح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Blitz braucht fast eine Minute über den Himmel – du kannst zusehen, wie sich jeder Ast entfaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un relámpago tarda casi un minuto en cruzar el cielo, así que puedes ver cómo se despliega cada rama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un éclair met près d’une minute à traverser le ciel : tu peux regarder chaque branche se déployer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fulmine impiega quasi un minuto ad attraversare il cielo, così puoi veder dispiegarsi ogni ramo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稲妻が空を横切るのに1分近くかかるので、枝分かれのひとつひとつが広がっていくのを見届けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번개가 하늘을 가로지르는 데 1분 가까이 걸려서, 가지 하나하나가 뻗어 나가는 걸 지켜볼 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relâmpago leva quase um minuto para atravessar o céu, e você pode ver cada ramo se abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Молния пересекает небо почти минуту — можно разглядеть, как раскрывается каждая её ветвь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายฟ้าใช้เวลาเกือบนาทีกว่าจะพาดผ่านท้องฟ้า คุณจึงได้เห็นทุกกิ่งก้านค่อย ๆ แตกแขนง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimşeğin gökyüzünü geçmesi neredeyse bir dakika sürüyor; her dalının açılışını izleyebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
