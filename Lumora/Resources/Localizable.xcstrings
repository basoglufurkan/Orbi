    },
    "You land in a meadow that hums softly. Every leaf turns, slowly, to see who has arrived." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تهبط في مرج يدندن بهدوء. كل ورقة تستدير ببطء لترى من وصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du landest auf einer leise summenden Wiese. Jedes Blatt dreht sich langsam um, um zu sehen, wer angekommen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aterrizas en una pradera que canturrea en voz baja. Cada hoja se gira, despacio, para ver quién ha llegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu te poses dans une prairie qui fredonne doucement. Chaque feuille se tourne, lentement, pour voir qui est arrivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atterri in un prato che canticchia piano. Ogni foglia si volta, lentamente, per vedere chi è arrivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしくハミングする草原に着陸します。葉という葉がゆっくりと振り向き、誰が来たのか確かめます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나지막이 콧노래하는 풀밭에 착륙해요. 잎사귀 하나하나가 누가 왔는지 보려고 천천히 몸을 돌려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pousa num campo que cantarola baixinho. Cada folha se vira, devagar, para ver quem chegou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты опускаешься на луг, который тихо напевает. Каждый листок медленно поворачивается — посмотреть, кто прилетел."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณลงจอดบนทุ่งหญ้าที่ฮัมเพลงแผ่วเบา ใบไม้ทุกใบค่อย ๆ หันมาดูว่าใครมาเยือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usulca mırıldanan bir çayıra iniyorsun. Her yaprak, kimin geldiğini görmek için yavaşça dönüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你降落在一片轻轻哼唱的草地上。每一片叶子都缓缓转过来，想看看是谁来了。"
          }
        }
      }
    },
