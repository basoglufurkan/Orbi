    "Whoever built this ring left the gardens tended and the lights on, as if they knew someone would come." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيًّا كان من بنى هذه الحلقة، فقد ترك الحدائق مرعيّة والأضواء مُنارة، كأنه كان يعلم أن أحدًا سيأتي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer auch immer diesen Ring gebaut hat, ließ die Gärten gepflegt und die Lichter an, als wüsste er, dass jemand kommen würde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien construyó este anillo dejó los jardines cuidados y las luces encendidas, como si supiera que alguien vendría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui que soient les bâtisseurs de cet anneau, ils ont laissé les jardins entretenus et les lumières allumées, comme s’ils savaient que quelqu’un viendrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha costruito questo anello ha lasciato i giardini curati e le luci accese, come se sapesse che qualcuno sarebbe arrivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この環を築いた誰かは、庭の手入れをして、灯りをつけたままにしていきました。いつか誰かが来ると知っていたかのように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 고리를 지은 누군가는 정원을 가꿔 두고 불을 켜 둔 채 떠났어요. 언젠가 누군가 올 걸 알았던 것처럼."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem construiu este anel deixou os jardins cuidados e as luzes acesas, como se soubesse que alguém viria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто бы ни построил это кольцо, он оставил сады ухоженными, а огни — зажжёнными, словно знал, что кто-то придёт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ว่าใครจะสร้างวงแหวนนี้ เขาทิ้งสวนไว้อย่างได้รับการดูแลและเปิดไฟไว้ ราวกับรู้ว่าจะมีใครสักคนมาเยือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu halkayı kim kurduysa bahçeleri bakımlı, ışıkları açık bırakmış; sanki birinin geleceğini biliyormuş gibi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建造这道环的人，把花园照料得好好的，灯也一直亮着，仿佛知道总会有人到来。"
          }
        }
      }
    },
    "Without a day it stays in Today" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون تحديد يوم تبقى في «اليوم»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Tag bleibt sie in „Heute“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin día, se queda en Hoy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans jour, elle reste dans Aujourd’hui"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un giorno resta in Oggi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付がなければ「今日」に残ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜가 없으면 '오늘'에 남아요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem um dia, ela fica em Hoje"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без даты остаётся в «Сегодня»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่ระบุวัน จะอยู่ในวันนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün seçilmezse Bugün'de kalır"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未选日期则保留在“今天”"
          }
        }
      }
    },
