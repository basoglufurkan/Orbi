    " complete today's constellation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " تُكمل كوكبة اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " vervollständigen das heutige Sternbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " completan la constelación de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " complètent la constellation du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " completano la costellazione di oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "で今日の星座が完成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 집중하면 오늘의 별자리가 완성돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " completam a constelação de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " завершат созвездие дня."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่มดาววันนี้ก็จะสมบูรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " bugünün takımyıldızını tamamlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即可连成今天的星座。"
          }
        }
      }
    },
