    "Notifications are off for Orbi. Live Activities still show your session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة لـ Orbi. وما زالت الأنشطة المباشرة تعرض جلستك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind für Orbi deaktiviert. Live-Aktivitäten zeigen deine Session trotzdem an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Orbi están desactivadas. Las Actividades en Vivo siguen mostrando tu sesión."
          }
        },
        "fr" : {
