        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この集中モードがオンのときに、Orbiが最初に使うカテゴリと環境音を選びましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 집중 모드가 켜져 있을 때 Orbi가 시작할 카테고리와 배경음을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a categoria e o ambiente com que o Orbi começa enquanto este Foco estiver ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери категорию и атмосферу, с которыми Orbi запускается, пока включён этот режим фокусирования."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกหมวดหมู่และเสียงบรรยากาศที่ Orbi จะใช้เริ่มต้นขณะเปิดโหมดโฟกัสนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Odak modu açıkken Orbi'nin hangi kategori ve ortam sesiyle başlayacağını seç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择开启此专注模式时 Orbi 默认使用的类别和环境音。"
          }
        }
      }
    },
    "Cities wake up on the night side, and a station circles in orbit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستيقظ المدن على الجانب الليلي، وتدور محطة في المدار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Nachtseite erwachen Städte, und im Orbit kreist eine Station."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ciudades despiertan en el lado nocturno y una estación gira en órbita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des villes s’éveillent sur la face nocturne, et une station tourne en orbite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le città si risvegliano sul lato notturno, e una stazione gira in orbita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜の側では街が目を覚まし、軌道をステーションがめぐります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤이 된 쪽에서 도시들이 깨어나고, 궤도에는 정거장이 돌아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidades despertam no lado noturno, e uma estação circula em órbita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На ночной стороне просыпаются города, а по орбите кружит станция."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองต่าง ๆ ตื่นขึ้นบนด้านกลางคืน และสถานีอวกาศโคจรอยู่รอบ ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece yüzünde şehirler uyanıyor, yörüngede bir istasyon dönüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜面的城市渐次苏醒，一座空间站在轨道上环绕。"
          }
        }
      }
    },
