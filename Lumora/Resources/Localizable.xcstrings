    "Pay once and every Orbi+ feature is yours, now and in every update." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع مرة واحدة وتصبح كل ميزات Orbi+ لك، الآن وفي كل تحديث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen, und jede Orbi+-Funktion gehört dir – jetzt und in jedem Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una vez y todas las funciones de Orbi+ son tuyas, ahora y en cada actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paie une fois et chaque fonction Orbi+ est à toi, maintenant et à chaque mise à jour."
