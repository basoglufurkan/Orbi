    "Six radiant arms turn so slowly that they seem to stand still." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستّ أذرع مشعّة تدور ببطء شديد حتى لتبدو ساكنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sechs strahlende Arme drehen sich so langsam, dass sie stillzustehen scheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis brazos radiantes giran tan despacio que parecen inmóviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six bras radieux tournent si lentement qu’ils semblent immobiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei bracci radiosi ruotano così lentamente da sembrare immobili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光り輝く6本の腕が、止まって見えるほどゆっくりと回っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찬란한 여섯 팔이 멈춘 듯 보일 만큼 천천히 돌아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis braços radiantes giram tão devagar que parecem parados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шесть сияющих рукавов вращаются так медленно, что кажутся неподвижными."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แขนเจิดจรัสทั้งหกหมุนช้าเสียจนดูเหมือนหยุดนิ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altı ışıltılı kol öyle yavaş dönüyor ki duruyormuş gibi görünüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "六条璀璨的旋臂转得极慢，仿佛静止不动。"
          }
        }
      }
    },
    "Sixty minutes that were entirely yours." : {
