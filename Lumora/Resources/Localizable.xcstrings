    "A beautiful map of this galaxy, with one corner left blank, as if saved for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة بديعة لهذه المجرّة، تُرك فيها ركن واحد فارغًا، كأنه محفوظ لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine wunderschöne Karte dieser Galaxie, eine Ecke noch leer, als hätte man sie für dich aufgehoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un precioso mapa de esta galaxia, con una esquina en blanco, como si la hubieran guardado para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte magnifique de cette galaxie, dont un coin est resté vierge, comme s’il t’était réservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una splendida mappa di questa galassia, con un angolo lasciato in bianco, come se l'avessero tenuto per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この銀河の美しい地図。ひと隅だけが空白のまま、まるであなたのために残してあるかのようです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 은하를 담은 아름다운 지도. 한쪽 귀퉁이만 비어 있어요. 마치 나를 위해 남겨 둔 것처럼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lindo mapa desta galáxia, com um canto deixado em branco, como se estivesse guardado para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прекрасная карта этой галактики, где один уголок оставлен пустым — словно его приберегли для тебя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนที่อันงดงามของกาแล็กซีนี้ เว้นมุมหนึ่งไว้ว่าง ราวกับเก็บไว้ให้คุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu galaksinin güzel bir haritası; bir köşesi boş bırakılmış, sanki senin için ayrılmış gibi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这片星系的一幅美丽地图，只留下一角空白，仿佛专为你而留。"
          }
        }
      }
    },
    "A blank sky" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سماء خالية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein leerer Himmel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cielo en blanco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ciel vierge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cielo vuoto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まっさらな空"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텅 빈 하늘"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um céu em branco"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чистое небо"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท้องฟ้าว่างเปล่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş bir gökyüzü"
          }
        },
