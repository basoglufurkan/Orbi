    "Four lights reached for each other and held on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أربعة أضواء امتدّ بعضها إلى بعض وتماسكت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier Lichter griffen nacheinander und hielten sich fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro luces se buscaron y no se soltaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatre lumières se sont tendu la main, et ne se sont plus lâchées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
