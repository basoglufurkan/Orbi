        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün yörüngesini açar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开今天的轨道"
          }
        }
      }
    },
    "Optional Screen Time shielding needs Apple's Family Controls approval. Orbi never sees or blocks other apps without your explicit consent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب درع «مدة استخدام الجهاز» الاختياري موافقة Apple على أدوات التحكم العائلية. لا يرى Orbi التطبيقات الأخرى ولا يحظرها أبدًا دون موافقتك الصريحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die optionale Bildschirmzeit-Sperre benötigt Apples Genehmigung für Family Controls. Orbi sieht oder blockiert andere Apps nie ohne deine ausdrückliche Zustimmung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escudo opcional de Tiempo de uso necesita la aprobación de Family Controls de Apple. Orbi nunca ve ni bloquea otras apps sin tu consentimiento explícito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage facultatif via Temps d’écran nécessite l’autorisation Family Controls d’Apple. Orbi ne voit ni ne bloque jamais d’autres apps sans ton consentement explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scudo facoltativo di Tempo di utilizzo richiede l'approvazione di Family Controls di Apple. Orbi non vede né blocca mai altre app senza il tuo consenso esplicito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のスクリーンタイムによるシールドには、AppleのFamily Controlsの承認が必要です。Orbiが明示的な同意なしに他のアプリを見たりブロックしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항인 스크린 타임 차단 기능은 Apple의 Family Controls 승인이 필요해요. Orbi는 명시적인 동의 없이 다른 앱을 보거나 차단하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A proteção opcional do Tempo de Uso precisa da aprovação do Family Controls da Apple. O Orbi nunca vê nem bloqueia outros apps sem o seu consentimento explícito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для необязательной защиты через Экранное время нужно одобрение Apple Family Controls. Orbi никогда не видит и не блокирует другие приложения без твоего явного согласия."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การป้องกันด้วยเวลาหน้าจอ (ไม่บังคับ) ต้องได้รับอนุมัติการควบคุมโดยครอบครัวของ Apple โดย Orbi จะไม่ดูหรือบล็อกแอปอื่นเลยหากไม่ได้รับความยินยอมจากคุณอย่างชัดเจน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı Ekran Süresi kalkanı, Apple'ın Aile Denetimleri onayını gerektirir. Orbi açık iznin olmadan diğer uygulamaları asla görmez ya da engellemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选的屏幕使用时间屏蔽功能需要 Apple 家人控制授权。未经你的明确同意，Orbi 绝不会查看或屏蔽其他 App。"
          }
        }
      }
    },
    "Optional, like “Thesis”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري، مثل «الأطروحة»"
