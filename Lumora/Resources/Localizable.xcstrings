    "Hundreds of kites tied to the ground, still flying after all these years." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مئات الطائرات الورقية مربوطة بالأرض، وما زالت تحلّق بعد كل هذه السنين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunderte Drachen, am Boden festgebunden, die nach all den Jahren noch immer fliegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cientos de cometas atadas al suelo, que siguen volando después de tantos años."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des centaines de cerfs-volants attachés au sol, qui volent encore après toutes ces années."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centinaia di aquiloni legati al suolo, che volano ancora dopo tutti questi anni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地面につながれた何百もの凧が、長い年月を経たいまも空を舞っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "땅에 매인 수백 개의 연이 오랜 세월이 흐른 지금도 날고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centenas de pipas presas ao chão, ainda voando depois de tantos anos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сотни воздушных змеев, привязанных к земле, — и спустя столько лет они всё ещё летают."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ว่าวนับร้อยถูกผูกไว้กับพื้นดิน และยังคงโบยบินแม้ผ่านมาหลายปี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yere bağlı yüzlerce uçurtma; bunca yıl sonra hâlâ uçuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数百只风筝系在地上，这么多年过去，依然在空中飞翔。"
          }
        }
      }
    },
