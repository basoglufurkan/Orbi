    "Someone built a ring around a star, and left a light on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحدهم بنى حلقة حول نجم، وترك ضوءًا مُضاءً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat einen Ring um einen Stern gebaut und ein Licht brennen lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien construyó un anillo alrededor de una estrella y dejó una luz encendida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un a bâti un anneau autour d’une étoile, et a laissé une lumière allumée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno ha costruito un anello attorno a una stella, e ha lasciato una luce accesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かが星のまわりに環を築き、灯りをつけたままにしていきました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 별 둘레에 고리를 짓고, 불을 켜 둔 채 떠났어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém construiu um anel em volta de uma estrela e deixou uma luz acesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то построил кольцо вокруг звезды и оставил свет включённым."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครบางคนสร้างวงแหวนรอบดาวฤกษ์ แล้วเปิดไฟทิ้งไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
