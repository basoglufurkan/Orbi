    "Life takes hold: luminous forests, reefs and spores glow in the dark." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدبّ الحياة: غابات مضيئة وشِعاب وأبواغ تتوهّج في الظلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leben fasst Fuß: Leuchtende Wälder, Riffe und Sporen glimmen im Dunkeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vida arraiga: bosques luminosos, arrecifes y esporas brillan en la oscuridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vie s’installe : forêts lumineuses, récifs et spores brillent dans l’obscurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vita mette radici: foreste luminose, barriere coralline e spore brillano nel buio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生命が根づきます。光る森やサンゴ礁、胞子が暗闇に輝きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생명이 뿌리내려요. 빛나는 숲과 산호초, 포자가 어둠 속에서 반짝여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vida se instala: florestas luminosas, recifes e esporos brilham no escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приходит жизнь: в темноте светятся сияющие леса, рифы и споры."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชีวิตหยั่งราก: ป่าเรืองแสง แนวปะการัง และสปอร์ส่องประกายในความมืด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşam tutunuyor: ışıltılı ormanlar, resifler ve sporlar karanlıkta parlıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生命扎下根来：发光的森林、珊瑚礁与孢子在黑暗中闪烁。"
          }
        }
      }
    },
