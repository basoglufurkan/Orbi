    "Sealed in glass and written in a language of dots. It seems to be a thank-you note." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختومة في زجاج ومكتوبة بلغة من النقاط. يبدو أنها رسالة شكر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Glas versiegelt und in einer Sprache aus Punkten geschrieben. Es scheint ein Dankesbrief zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellada en cristal y escrita en un idioma de puntos. Parece una nota de agradecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scellée dans le verre et écrite dans une langue faite de points. On dirait un mot de remerciement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigillata nel vetro e scritta in una lingua di puntini. Sembra un biglietto di ringraziamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガラスに封じられ、点でできた言葉で書かれています。どうやらお礼の手紙のようです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유리에 봉해진 채 점으로 된 언어로 쓰여 있어요. 아무래도 감사 편지인 것 같아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selada no vidro e escrita numa língua de pontinhos. Parece ser um bilhete de agradecimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запечатано в стекле и написано языком точек. Похоже, это благодарственная записка."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดผนึกในแก้วและเขียนด้วยภาษาแห่งจุด ดูเหมือนจะเป็นจดหมายขอบคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cama mühürlenmiş, noktalardan bir dille yazılmış. Bir teşekkür notuna benziyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
