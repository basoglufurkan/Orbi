          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在App Storeに接続できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 App Store에 연결할 수 없어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
