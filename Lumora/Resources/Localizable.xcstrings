    "Eclipse and Opal paints and a Supernova trail, still earned with stardust." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلاءا الكسوف والأوبال وذيل المستعر الأعظم، وما زالت تُكتسب بغبار النجوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lackierungen Finsternis und Opal und die Supernova-Spur, weiterhin mit Sternenstaub verdient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pinturas Eclipse y Ópalo y la estela Supernova, que se siguen ganando con polvo de estrellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les peintures Éclipse et Opale et la traînée Supernova, toujours gagnées avec de la poussière d'étoiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vernici Eclissi e Opale e la scia Supernova, sempre guadagnate con la polvere di stelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日食とオパールの塗装、スーパーノヴァの軌跡。手に入れるのは今までどおり星屑で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일식·오팔 도색과 초신성 궤적. 여전히 별가루로 얻어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pinturas Eclipse e Opala e o rastro Supernova, ainda conquistados com poeira estelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окраски «Затмение» и «Опал» и шлейф «Сверхновая» — по-прежнему за звёздную пыль."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีสุริยุปราคาและโอปอล และหางซูเปอร์โนวา ยังคงได้มาด้วยฝุ่นดาว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutulma ve Opal boyaları ile Süpernova izi; yine de yıldız tozuyla kazanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日食与欧泊涂装，以及超新星尾迹，仍需用星尘获得。"
          }
        }
      }
    },
