            "value" : "Песня пульсара"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บทเพลงของพัลซาร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsarın şarkısı"
          }
