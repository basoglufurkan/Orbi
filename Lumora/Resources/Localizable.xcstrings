    "Dusk lasts a whole season here, and everything is painted in violet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدوم الغسق هنا فصلًا كاملًا، وكل شيء مطليّ بالبنفسجي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dämmerung dauert hier eine ganze Jahreszeit, und alles ist in Violett getaucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí el crepúsculo dura toda una estación, y todo se tiñe de violeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, le crépuscule dure toute une saison, et tout se teinte de violet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui il crepuscolo dura un'intera stagione, e tutto si tinge di viola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは夕暮れがひと季節続き、すべてがすみれ色に染まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳에선 해 질 녘이 한 계절 내내 이어지고, 모든 것이 보랏빛으로 물들어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui o crepúsculo dura uma estação inteira, e tudo fica pintado de violeta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумерки здесь длятся целый сезон, и всё вокруг окрашено в фиолетовый."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่นี่ แสงสนธยาอยู่ได้ตลอดทั้งฤดู และทุกสิ่งถูกระบายด้วยสีม่วง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada alacakaranlık koca bir mevsim sürüyor ve her şey mora boyanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里，黄昏会持续整整一季，万物都染上紫罗兰色。"
          }
        }
      }
    },
