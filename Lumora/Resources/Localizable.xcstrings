          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder Fokus für den ganzen Block · %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O concéntrate durante todo el bloque · %@"
          }
