    "Sessions shorter than %lld minutes rest without a star. Your universe stays exactly as it is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجلسات الأقصر من %lld دقيقة تستريح بلا نجمة. ويبقى كونك كما هو تمامًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions unter %lld Minuten ruhen ohne Stern. Dein Universum bleibt genau so, wie es ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones de menos de %lld minutos descansan sin estrella. Tu universo sigue exactamente igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séances de moins de %lld minutes se reposent sans étoile. Ton univers reste exactement tel qu’il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni più brevi di %lld minuti riposano senza stella. Il tuo universo resta esattamente com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld分より短いセッションは、星をつくらずに休みます。宇宙はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld분보다 짧은 세션은 별 없이 쉬어 가요. 우주는 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões com menos de %lld minutos descansam sem estrela. Seu universo fica exatamente como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессии короче %lld минут отдыхают без звезды. Твоя вселенная остаётся такой же, как была."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันที่สั้นกว่า %lld นาทีจะไม่สร้างดาว จักรวาลของคุณจะยังคงเหมือนเดิมทุกอย่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dakikadan kısa seanslar yıldızsız dinlenir. Evrenin olduğu gibi kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少于 %lld 分钟的专注不会生成星星，你的宇宙会保持原样。"
          }
        }
      }
    },
    "Sessions under %lld minutes rest without a star. Nothing changed, nothing was lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجلسات الأقل من %lld دقيقة تستريح بلا نجمة. لم يتغيّر شيء، ولم يضِع شيء."
          }
        },
        "de" : {
          "stringUnit" : {
