    "Dozens of clocks planted in a field, each one keeping the time of a different world." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشرات الساعات مغروسة في حقل، كل واحدة تحفظ وقت عالَم مختلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutzende Uhren, auf einem Feld gepflanzt, und jede geht nach der Zeit einer anderen Welt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decenas de relojes plantados en un campo, cada uno marcando la hora de un mundo distinto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des dizaines d’horloges plantées dans un champ, chacune donnant l’heure d’un monde différent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decine di orologi piantati in un campo, ognuno con l'ora di un mondo diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "野原に植えられた何十もの時計。それぞれが、別々の世界の時を刻んでいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들판에 심어진 수십 개의 시계. 저마다 다른 세계의 시간을 가리켜요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezenas de relógios plantados num campo, cada um marcando a hora de um mundo diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Десятки часов, посаженных в поле, — и каждые идут по времени другого мира."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นาฬิกานับสิบเรือนปลูกเรียงอยู่กลางทุ่ง แต่ละเรือนบอกเวลาของโลกที่ต่างกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir tarlaya dikilmiş düzinelerce saat; her biri başka bir dünyanın zamanını tutuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "田野里种着几十座时钟，每一座都守着不同世界的时间。"
          }
        }
      }
    },
