    "Rain falls upward here, slowly, and settles on the clouds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنا يهطل المطر إلى الأعلى، ببطء، ويستقرّ على الغيوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier fällt der Regen langsam nach oben und legt sich auf die Wolken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí la lluvia cae hacia arriba, despacio, y se posa sobre las nubes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, la pluie tombe vers le haut, lentement, et se pose sur les nuages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui la pioggia cade verso l'alto, lentamente, e si posa sulle nuvole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは雨がゆっくりと上へ降り、雲の上に積もります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이곳에선 비가 천천히 위로 내려 구름 위에 내려앉아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui a chuva cai para cima, devagar, e pousa nas nuvens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождь здесь идёт вверх — неспешно — и оседает на облаках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่นี่ฝนตกขึ้นฟ้า ช้า ๆ แล้วไปพักอยู่บนก้อนเมฆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada yağmur yukarı doğru, ağır ağır yağıyor ve bulutların üstüne konuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里的雨缓缓向上落去，停驻在云朵上。"
          }
        }
      }
    },
