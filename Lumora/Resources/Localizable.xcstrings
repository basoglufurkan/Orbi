    "At %@. A few breaths to settle in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الساعة %@. أنفاس قليلة لتستقرّ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@. Ein paar Atemzüge, um anzukommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las %@. Unas respiraciones para acomodarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@. Quelques respirations pour t’installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@. Qualche respiro per raccoglierti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@から。ゆっくり呼吸して、心を整えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 시작해요. 숨을 몇 번 고르며 마음을 가다듬어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às %@. Algumas respirações para se acomodar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@. Пара вдохов, чтобы настроиться."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลา %@ หายใจลึก ๆ สักสองสามครั้งให้ใจสงบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat %@. Hazırlanmak için birkaç nefes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@开始。深呼吸几次，静下心来。"
          }
        }
      }
    },
    "At night the sea glows from beneath, and the distant storms sing in long, low chords." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الليل يتوهّج البحر من أعماقه، وتغنّي العواصف البعيدة بأوتار طويلة خفيضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts leuchtet das Meer von unten, und ferne Stürme singen in langen, tiefen Akkorden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche, el mar brilla desde el fondo, y las tormentas lejanas cantan en acordes largos y graves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit, la mer s’illumine par en dessous, et les tempêtes lointaines chantent en longs accords graves."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte il mare si illumina dal profondo, e le tempeste lontane cantano in lunghi accordi profondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜になると海は底から光り、遠くの嵐が長く低い和音で歌います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤이 되면 바다가 아래에서부터 빛나고, 먼 폭풍이 길고 낮은 화음으로 노래해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noite, o mar brilha lá do fundo, e as tempestades distantes cantam em acordes longos e graves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночью море светится из глубины, а далёкие бури поют долгими низкими аккордами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยามค่ำคืน ทะเลเรืองแสงจากเบื้องลึก และพายุที่อยู่ไกลออกไปขับขานด้วยคอร์ดทุ้มต่ำยาวนาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geceleri deniz derinden ışıldıyor, uzak fırtınalar uzun, pes akorlarla şarkı söylüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里，海从深处亮起，远方的风暴以悠长低沉的和弦歌唱。"
          }
        }
      }
    },
