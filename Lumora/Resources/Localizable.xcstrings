    "Curtains of green and violet light ripple from one edge of the sky to the other." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستائر من نور أخضر وبنفسجي تتموّج من طرف السماء إلى طرفها الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhänge aus grünem und violettem Licht wogen von einem Rand des Himmels zum anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortinas de luz verde y violeta ondean de un extremo a otro del cielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rideaux de lumière verte et violette ondulent d’un bord à l’autre du ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tende di luce verde e viola ondeggiano da un capo all'altro del cielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑とすみれ色の光のカーテンが、空の端から端までゆらめきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초록빛과 보랏빛 커튼이 하늘 이쪽 끝에서 저쪽 끝까지 일렁여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortinas de luz verde e violeta ondulam de uma ponta à outra do céu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занавеси зелёного и фиолетового света колышутся от края до края неба."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ม่านแสงสีเขียวและสีม่วงพลิ้วไหวจากขอบฟ้าด้านหนึ่งไปยังอีกด้านหนึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeşil ve mor ışıktan perdeler gökyüzünün bir ucundan öbür ucuna dalgalanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绿色与紫罗兰色的光幕，从天空的一端荡漾到另一端。"
          }
        }
      }
    },
