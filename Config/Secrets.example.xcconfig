// Copy this file to Config/Secrets.xcconfig and fill it in. Secrets.xcconfig is
// ignored by git, so the keys stay on your machine.
//
// RevenueCat › Project settings › API keys, the public SDK keys:
// - Debug: the Test Store key (test_…), which simulates purchases without
//   App Store Connect.
// - Release: the App Store key (appl_…). A Test Store key in a build sent to
//   App Review gets it rejected.
//
// Leave a key empty and Orbi+ purchases stay off in that configuration
// (DEBUG builds still show sample prices so the paywall can be designed).

REVENUECAT_API_KEY[config=Debug] =
REVENUECAT_API_KEY[config=Release] =
