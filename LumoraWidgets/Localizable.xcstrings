    "Marks one of your habits as done for today, or opens it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل إحدى عاداتك مُتمّة اليوم، أو يعيد فتحها."
          }
        },
        "de" : {
          "stringUnit" : {
