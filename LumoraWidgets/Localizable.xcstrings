    "The time over your own stars. Made for StandBy while your iPhone charges." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقت فوق نجومك. مصمَّم لوضع StandBy أثناء شحن iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhrzeit über deinen eigenen Sternen. Für StandBy, während dein iPhone lädt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora sobre tus propias estrellas. Pensada para StandBy mientras tu iPhone carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’heure au-dessus de tes propres étoiles. Pensée pour StandBy pendant que ton iPhone charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ora sopra le tue stelle. Pensato per StandBy mentre l’iPhone è in carica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなた自身の星の上に時刻を。iPhoneの充電中、StandByのために。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 별 위에 시간을. iPhone을 충전하는 동안 StandBy에서."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hora sobre as suas próprias estrelas. Feito para o StandBy enquanto o iPhone carrega."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время на фоне твоих звёзд. Для режима StandBy, пока iPhone заряжается."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาบนดวงดาวของคุณเอง สำหรับโหมด StandBy ระหว่างชาร์จ iPhone"
