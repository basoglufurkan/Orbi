    "Your current rhythm of focus days. One rest day a week is free." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاعك الحالي من أيام التركيز. يوم راحة واحد في الأسبوع مجاني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktueller Rhythmus an Fokustagen. Ein Ruhetag pro Woche ist frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ritmo actual de días de enfoque. Un día de descanso a la semana no lo rompe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton rythme actuel de jours de concentration. Un jour de repos par semaine est offert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo ritmo attuale di giorni di concentrazione. Un giorno di riposo a settimana non lo interrompe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
