    "Ends the current focus session early. The time you focused is kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنهي جلسة التركيز الحالية مبكرًا. ويُحفظ الوقت الذي ركّزت فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die aktuelle Fokus-Session vorzeitig. Die Zeit, in der du fokussiert warst, bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina antes la sesión de enfoque actual. El tiempo que te concentraste se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine la séance de concentration en cours. Le temps passé à te concentrer est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina in anticipo la sessione di concentrazione in corso. Il tempo di concentrazione viene conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中の集中セッションを早めに終了します。集中した時間は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 집중 세션을 일찍 끝내요. 집중한 시간은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra a sessão de foco atual mais cedo. O tempo em que você focou é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досрочно завершает текущую фокус-сессию. Время фокуса сохраняется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จบเซสชันโฟกัสปัจจุบันก่อนเวลา เวลาที่คุณโฟกัสไปแล้วจะถูกเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süren odak seansını erken bitirir. Odaklandığın süre korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提前结束当前专注，已专注的时间会被保留。"
          }
        }
      }
    },
