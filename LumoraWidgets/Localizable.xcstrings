    "Starts a focus session with your usual length, or ends the one that's running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ جلسة تركيز بمدّتك المعتادة، أو يُنهي الجلسة الجارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine Fokus-Session mit deiner üblichen Länge oder beendet die laufende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una sesión de enfoque con tu duración habitual o termina la que está en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance une séance de concentration de ta durée habituelle, ou termine celle en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una sessione di concentrazione con la tua durata abituale o termina quella in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの長さで集中セッションを始めるか、進行中のセッションを終えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소 길이로 집중 세션을 시작하거나 진행 중인 세션을 끝내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
