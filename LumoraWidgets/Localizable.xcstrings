          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca uno de tus hábitos como cumplido hoy, o lo vuelve a abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque l’une de tes habitudes comme faite aujourd’hui, ou la rouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna una delle tue abitudini come completata oggi, o la riapre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "習慣のひとつを今日の分として達成にするか、未達成に戻します。"
