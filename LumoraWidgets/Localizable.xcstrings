        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเซสชันโฟกัสด้วยความยาวที่คุณใช้ประจำ หรือจบเซสชันที่กำลังดำเนินอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
