    "Keep today's habits with a tap and watch their stars brighten." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أتمّ عادات اليوم بلمسة وشاهد نجومها تسطع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hake die heutigen Gewohnheiten mit einem Tippen ab und sieh zu, wie ihre Sterne heller werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumple los hábitos de hoy con un toque y mira cómo brillan sus estrellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coche les habitudes du jour d’un geste et regarde leurs étoiles s’illuminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa le abitudini di oggi con un tocco e guarda le loro stelle accendersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで今日の習慣を達成して、星が明るくなるのを見届けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 한 번으로 오늘의 습관을 완료하고 별이 밝아지는 모습을 지켜보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumpra os hábitos de hoje com um toque e veja as estrelas deles brilharem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечай привычки одним касанием и смотри, как разгораются их звёзды."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อทำนิสัยของวันนี้ แล้วดูดาวของมันสว่างขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünün alışkanlıklarını tek dokunuşla tamamla, yıldızlarının parlayışını izle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一下完成今天的习惯，看它们的星渐渐变亮。"
          }
        }
      }
    },
